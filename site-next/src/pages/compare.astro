---
import Base from '../layouts/Base.astro';
import { products, rows, notes, groupLabels, REVIEWED, centralCols, centralRows, centralSources, type Group } from '../data/compare';

const filters: { key: 'all' | Group; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'open', label: groupLabels.open },
  { key: 'commercial', label: groupLabels.commercial },
  { key: 'appliance', label: groupLabels.appliance },
];
const others = products.filter((p) => p.id !== 'freesense');
const isGap = (v: string) => v === '—';

const fleet = [
  { t: 'Self-hosted and private', d: 'There is no Fleet cloud and no account. The controller is a FreeSense system you run, and your data stays on it. Fleet makes no connection to FreeSense servers.' },
  { t: 'Safe joining', d: 'A firewall joins by pasting an invitation and comparing a 6-digit approval code, or zero-touch from a seed on USB or in cloud-init for batch deployments.' },
  { t: 'Updates in rings', d: 'Roll updates out in stages, with maintenance windows and rolling reboots. Each firewall gets a fresh boot environment on ZFS.' },
  { t: 'Templates and policies', d: 'Push configuration templates and policies that audit, remediate or lock settings, with commit-confirm on rules so a bad change undoes itself.' },
  { t: 'Backups, HA and a NOC view', d: 'Backups of every firewall kept on the controller, CARP pairs set up from two firewalls, and a live dashboard with a full-screen NOC view. Firewalls keep forwarding if the controller is down.' },
];

const connections = [
  { t: 'Fleet tunnel', d: 'A built-in WireGuard management tunnel that each firewall opens to the controller, so sites behind NAT or CGNAT can join.' },
  { t: 'Tailscale', d: 'Join over your tailnet, with no public port on the controller. Optional, and the one part that uses a third-party service.' },
  { t: 'Direct', d: 'Reach the controller straight over your LAN, MPLS or an existing VPN.' },
];

const faq = [
  { q: 'Is FreeSense a fork of pfSense?', a: 'FreeSense started from pfSense CE and is rebuilt from source on FreeBSD 16. Vendor registration, telemetry and upsell prompts were removed, and the WebUI, REST API and package manager are being rebuilt. Both share the pf packet filter.' },
  { q: 'Why choose FreeSense over OPNsense or pfSense?', a: 'Choose it if you value a fully open build you can trace from source to signed image, with no vendor account. If you need commercial support, a long track record or a large plugin catalogue today, OPNsense and pfSense Plus are more mature choices.' },
  { q: 'Can I move my pfSense configuration to FreeSense?', a: 'FreeSense keeps a familiar configuration model, but there is no official migration tool yet. Test an import on a VM before you move production.' },
  { q: 'Does FreeSense run on ARM or vendor appliances?', a: 'Stable releases are amd64. ARM64 builds, including Raspberry Pi, are in Development only. FreeSense runs on your own hardware, VMs and clouds; it does not sell appliances.' },
  { q: 'What does "—" mean in the table?', a: 'We could not verify it from a public source when we reviewed the page. It does not mean the product lacks the feature. Corrections with a source are welcome on GitHub.' },
  { q: 'When is Fleet available?', a: 'Fleet is part of FreeSense 1.2 and is planned for early 2027. You can try it in Development builds today, where it is experimental; it will not come to Stable 1.1.' },
  { q: 'Does Fleet need a cloud service?', a: 'No. Fleet is self-hosted by design: the controller is a FreeSense system you run, and nothing is sent to FreeSense. You can still run the controller on a server or cloud account that you own, from a FreeSense cloud image, and manage your firewalls from there.' },
];

const sources = products.flatMap((p) => p.source.map((s) => ({ ...s, product: p.name })))
  .concat(notes.map((n) => ({ ...n.source, product: 'Arista ETM' })))
  .concat(centralSources.map((s) => ({ label: s.label, href: s.href, product: `${s.product} (central management)` })));
---

<Base
  title="Compare FreeSense with pfSense, OPNsense, MikroTik and more"
  description="A fair, sourced comparison of FreeSense with other self-hosted firewalls and routers: pfSense CE and Plus, OPNsense, MikroTik RouterOS, OpenWrt, IPFire, VyOS, Sophos, UniFi and FortiGate."
  current="compare"
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow reveal">Compare</span>
      <h1 class="reveal d1">How FreeSense compares.</h1>
      <p class="lead-muted reveal d2 compare-lead">
        Open and closed, software and appliances: the firewalls people usually weigh against FreeSense. We only list
        what we could verify from a public source, and we say where others are the better fit.
      </p>
      <p class="compare-reviewed reveal d3">Last reviewed {REVIEWED} &middot; <a href="#sources">Sources</a></p>
    </div>
  </section>

  <section class="compare-table-section" aria-labelledby="table-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title" id="table-title">Side by side</h2>
        <div class="chip-row" role="group" aria-label="Filter products">
          {filters.map((f, i) => (
            <button type="button" class="chip" data-compare-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      </div>
      <p class="compare-hint">FreeSense stays in view while you filter. On small screens, swipe the table sideways.</p>
      <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="table-title">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col" class="c-feature">Feature</th>
              {products.map((p) => (
                <th scope="col" class:list={['c-prod', { 'is-fs': p.id === 'freesense' }]} data-col={p.id} data-groups={p.groups.join(' ')}>
                  <span class="c-name">{p.name}</span>
                  <span class="c-vendor">{p.vendor}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row" class="c-feature">{r.label}</th>
                {products.map((p) => {
                  const v = p.values[r.key] ?? '—';
                  return (
                    <td class:list={[{ 'is-fs': p.id === 'freesense', 'is-gap': isGap(v), 'is-soon': p.id === 'freesense' && r.key === 'central' }]} data-col={p.id}>
                      {isGap(v) ? <span aria-label="Not verified">—</span> : v}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-empty" hidden>No products in this filter.</p>
    </div>
  </section>

  <section class="fleet-teaser" aria-labelledby="fleet-title">
    <div class="wrap">
      <div class="fleet-card">
        <span class="soon-badge">Coming in FreeSense 1.2 &middot; planned for early 2027 &middot; try it in Development today</span>
        <h2 class="section-title" id="fleet-title">Fleet: central management that is yours.</h2>
        <p class="lead-muted">
          Most vendors sell central management separately or tie it to their cloud. Fleet is a free, self-hosted part of
          FreeSense 1.2: <b>not a cloud service</b>, with no account and nothing leaving your network unless you choose it.
          You can run the controller on your own network, on your own server, or on a public host that you control from a
          cloud image. It is experimental in Development today and is not part of Stable 1.1.
        </p>
        <div class="fleet-connect" aria-labelledby="connect-title">
          <h3 id="connect-title">Three ways to connect</h3>
          <div class="connect-grid">
            {connections.map((c, i) => (
              <div class="connect-item">
                <span class="connect-num">{String(i + 1).padStart(2, '0')}</span>
                <h4>{c.t}</h4>
                <p>{c.d}</p>
              </div>
            ))}
          </div>
          <p class="connect-advisor">Fleet shows warnings and recommendations for each method, and checks that the controller is reachable before anything is set up.</p>
        </div>
        <div class="fleet-grid">
          {fleet.map((f) => (
            <div class="fleet-item">
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))}
        </div>
        <p class="fleet-note">Features and timing can change before release. <a href="/fleet/">See the Fleet page</a>, the <a href="https://docs.freesense.org/1.2/configure/fleet/" rel="noopener">documentation</a>, or follow progress in <a href="/news/">News</a>.</p>
      </div>
    </div>
  </section>

  <section class="central-compare" id="central" aria-labelledby="central-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Central management</span>
          <h2 class="section-title mb-0" id="central-title">Fleet next to the others.</h2>
        </div>
        <p>What each central manager does today, from the vendors' own documentation. Fleet is experimental; the others are released products.</p>
      </div>
      <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="central-title">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col" class="c-feature">Capability</th>
              {centralCols.map((c) => (
                <th scope="col" class:list={['c-prod', { 'is-fs': c.id === 'fleet' }]}>
                  <span class="c-name">{c.name}</span>
                  <span class="c-vendor">{c.vendor}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {centralRows.map((r) => (
              <tr>
                <th scope="row" class="c-feature">{r.label}</th>
                {r.values.map((v, i) => (
                  <td class:list={[{ 'is-fs': i === 0, 'is-gap': isGap(v) }]}>
                    {isGap(v) ? <span aria-label="Not stated in the cited sources">&mdash;</span> : v}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-small" style="margin-top:.9rem">
        &ldquo;&mdash;&rdquo; means the sources below do not say, not that the feature is missing. FortiManager and the other
        products in the table above are not repeated here because we could not verify the same detail for them.
      </p>
      <ul class="source-list">
        {centralSources.map((s) => <li><span>{s.product}</span><a href={s.href} rel="noopener nofollow">{s.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="choose" aria-labelledby="choose-title">
    <div class="wrap">
      <h2 class="section-title" id="choose-title">Which one fits?</h2>
      <p class="lead-muted choose-lead">Every option here is a good choice for someone. An honest summary of each:</p>
      <div class="choose-grid">
        {products.map((p) => (
          <article class:list={['fs-card choose-card', { 'is-fs': p.id === 'freesense' }]} data-col={p.id} data-groups={p.groups.join(' ')}>
            <div class="choose-head">
              <h3>{p.name}</h3>
              <span class="choose-tags">{p.groups.map((g) => groupLabels[g]).join(' · ')}</span>
            </div>
            <p><strong>Choose {p.name} if</strong> {p.chooseIf}</p>
          </article>
        ))}
      </div>
      {notes.map((n) => <p class="compare-note">{n.text}</p>)}
    </div>
  </section>

  <section class="compare-faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 class="section-title" id="faq-title">Questions</h2>
      {faq.map((f) => (
        <details class="channel-details faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="compare-sources" id="sources" aria-labelledby="sources-title">
    <div class="wrap narrow">
      <h2 class="h4" id="sources-title">Sources</h2>
      <p class="compare-small">Reviewed {REVIEWED}. Products change; if something here is out of date, please open an issue with a source.</p>
      <ul class="source-list">
        {sources.map((s) => (
          <li><span>{s.product}</span><a href={s.href} rel="noopener nofollow">{s.label}</a></li>
        ))}
      </ul>
      <p class="compare-small trademark">
        pfSense and Netgate are trademarks of Rubicon Communications, LLC (Netgate). OPNsense is a trademark of Deciso B.V.
        MikroTik and RouterOS, OpenWrt, IPFire, VyOS, Sophos, Ubiquiti and UniFi, Fortinet, FortiGate and FortiOS, and Arista
        are trademarks of their respective owners. Names are used only to identify the products compared; FreeSense is not
        affiliated with or endorsed by any of them.
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/compare.js';
</script>
