---
import Base from '../layouts/Base.astro';
import Slider from '../components/Slider.astro';
import type { Slide } from '../components/Slider.astro';
import { news, formatDate } from '../data/news';
import { apps } from '../data/apps';

const GITHUB = 'https://github.com/FreeSense-org';
const DOCS = 'https://docs.freesense.org';
const netspider = apps.find((a) => a.slug === 'netspider')!;

const slides: Slide[] = [
  {
    id: 'freesense', label: 'FreeSense', theme: 'coral', eyebrow: 'Open-source firewall · FreeBSD 16',
    title: 'Your network.', accent: 'Fully in your hands.',
    body: 'A fast, transparent firewall operating system for people who want serious control without a closed platform. No accounts, no telemetry, no artificial limits.',
    href: '/download', cta: 'Download FreeSense', secondary: { href: DOCS, label: 'Explore the docs' }, visual: 'dashboard',
  },
  {
    id: 'devel', label: 'Live development', theme: 'green', eyebrow: 'Development 1.1 · built in public',
    title: 'Watch 1.1', accent: 'take shape.',
    body: 'The rolling Development line is rebuilt from source automatically. These are the newest changes, straight from the build pipeline. Experimental and unsupported, so keep it for the lab.',
    href: '#live', cta: 'See the live pipeline', secondary: { href: '/download', label: 'Try a dev build' }, visual: 'devel',
  },
  {
    id: 'netspider', label: 'NetSpider', theme: 'spider', eyebrow: 'New app · FreeSense family',
    title: 'Meet NetSpider.', accent: 'See where it breaks.',
    body: 'Our first desktop app maps every device on your network, measures latency at Layer 2 and 3, and pinpoints the failing hop. Free and open source for Windows.',
    href: '/apps/netspider', cta: 'Explore NetSpider', secondary: { href: '/news/introducing-netspider', label: 'Read the announcement' },
    image: '/apps/netspider/app-path-doctor.webp', imageAlt: 'NetSpider Path Doctor locating a failed ISP modem',
  },
  {
    id: 'stable', label: 'Stable', theme: 'coral', eyebrow: 'FreeSense Stable',
    title: 'The supported line.', accent: 'Signed and ready.',
    body: 'Install the current Stable release on hardware or a VM. Patch releases bring necessary security fixes through signed package repositories.',
    href: '/download', cta: 'Download Stable', secondary: { href: DOCS, label: 'Read the docs' }, visual: 'stable',
  },
  {
    id: 'cloud', label: 'Cloud images', theme: 'blue', eyebrow: 'Official cloud images',
    title: 'Boot the firewall.', accent: 'Skip the installer.',
    body: 'Preinstalled QCOW2 and raw GPT disks for Proxmox, OpenStack, QEMU/KVM and bhyve, with BIOS and UEFI boot and metadata-driven first boot.',
    href: '/download/?image=ufs&format=qcow2#release-channels', cta: 'Choose a cloud image',
    secondary: { href: DOCS + '/getting-started/cloud-images/', label: 'Deployment guide' }, visual: 'cloud',
  },
  {
    id: 'arm', label: 'ARM64', theme: 'green', eyebrow: 'Preview',
    title: 'FreeSense on ARM64', accent: 'and Raspberry Pi.',
    body: 'Try the generic ARM64 UEFI installer or the Raspberry Pi 4B and Pi 5 D0 appliance images. Experimental and unsupported, made for labs.',
    href: '/download', cta: 'See ARM64 downloads', secondary: { href: '/news/raspberry-pi-arm64-preview', label: 'Read the details' }, visual: 'arm',
  },
];

const vpns = [
  { name: 'WireGuard', color: '#ff6b4a' },
  { name: 'OpenVPN', color: '#50b7ff' },
  { name: 'IPsec', color: '#a78bfa' },
  { name: 'Tailscale', color: '#42d392' },
  { name: 'ZeroTier', color: '#f6c85f' },
];

const latestNews = news.slice(0, 3);
---

<Base
  title="FreeSense — the modern open firewall"
  description="FreeSense is a modern open-source firewall and router with signed installer and cloud images, no accounts, and no telemetry or phone-home."
>
  <Slider slides={slides} />

  <section class="pulse" aria-label="Live project status">
    <div class="wrap pulse-inner">
      <a href="/download" class="pulse-item"><span class="pulse-dot good"></span><small>Stable</small><b data-live="stable-version">1.0</b><em data-live="stable-ago"></em></a>
      <a href="#live" class="pulse-item"><span class="pulse-dot dev"></span><small>Development</small><b data-live="devel-version">1.1 dev</b><em data-live="devel-ago"></em></a>
      <a href="/download" class="pulse-item"><span class="pulse-dot dev"></span><small>ARM64 dev build</small><b>aarch64</b><em data-live="arm-ago"></em></a>
      <a href="/apps/netspider" class="pulse-item"><span class="pulse-dot ns"></span><small>NetSpider</small><b data-live="netspider-version">v{netspider.version}</b><em>Windows</em></a>
      <a href="https://github.com/freebsd/freebsd-src" class="pulse-item" rel="noopener"><span class="pulse-dot"></span><small>FreeBSD 16 pin</small><b><code data-live="freebsd-pin">pinned</code></b><em>ZFS recommended · UFS supported</em></a>
    </div>
  </section>

  <section id="live" class="live">
    <div class="wrap">
      <div class="heading split">
        <div><span class="eyebrow"><i class="live-dot"></i> Live from the pipeline</span><h2>What just shipped.</h2></div>
        <p>Pulled live from the signed release feeds and GitHub. Every build is pinned to exact source, ports and FreeBSD revisions you can inspect.</p>
      </div>

      <div class="channels">
        <article class="channel stable" id="live-stable">
          <header>
            <span class="ch-badge">Stable · Supported</span>
            <div class="ch-title"><strong class="ch-version">1.0</strong><span>released <time class="ch-when">recently</time></span></div>
          </header>
          <ul class="ch-changes"><li><span class="skel" style="width:88%"></span></li><li><span class="skel" style="width:72%"></span></li><li><span class="skel" style="width:80%"></span></li></ul>
          <div class="ch-stats"></div>
          <div class="ch-images"></div>
          <footer><a href="/download" class="btn btn-primary">Download Stable</a><a href="/download#release-channels">Full release notes →</a></footer>
        </article>

        <article class="channel devel" id="live-devel">
          <header>
            <span class="ch-badge">Development · Experimental</span>
            <div class="ch-title"><strong class="ch-version">1.1 dev</strong><span>built <time class="ch-when">recently</time></span></div>
          </header>
          <ul class="ch-changes"><li><span class="skel" style="width:84%"></span></li><li><span class="skel" style="width:90%"></span></li><li><span class="skel" style="width:66%"></span></li></ul>
          <div class="ch-stats"></div>
          <div class="ch-images"></div>
          <footer><a href="/download" class="btn btn-ghost">Get the dev build</a><a href={`${GITHUB}/freesense/commits/main`} rel="noopener">All commits →</a></footer>
        </article>
      </div>

      <div class="live-row">
        <div class="activity">
          <div class="panel-head"><h3>Development activity</h3><a href={GITHUB} rel="noopener">FreeSense-org on GitHub ↗</a></div>
          <ol class="act-list" id="live-activity">
            {[78, 64, 82, 58, 70].map((w) => <li><span class="act-dot"></span><div class="act-body"><span class="skel" style={`width:${w}%`}></span><span class="skel" style="width:30%;height:9px;margin-top:8px"></span></div></li>)}
          </ol>
        </div>
        <div class="verify">
          <div class="panel-head"><h3>Verify the latest build</h3></div>
          <p>The newest Development build was produced from these exact revisions. Pin, build, sign, publish, all in public CI.</p>
          <div class="prov" id="live-provenance">
            {['FreeSense source', 'System ports', 'Optional packages', 'OS definition', 'FreeBSD ports', 'FreeBSD src'].map((label) => (
              <span class="prov-skel"><span>{label}</span><span class="skel" style="width:84px"></span></span>
            ))}
          </div>
          <div class="pipeline-mini"><span>Pin</span><i>→</i><span>Build</span><i>→</i><span>Sign</span><i>→</i><span>Publish</span></div>
          <a href="/about" class="verify-link">How FreeSense is built →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="platform">
    <div class="wrap">
      <div class="heading centered"><span class="eyebrow">The platform</span><h2>One system. Your entire edge.</h2><p>From a quiet home lab to a multi-gigabit branch, FreeSense puts routing, security, VPN and observability in one coherent interface.</p></div>

      <div class="bento">
        <article class="tile t-route">
          <span class="t-icon"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 12h3a4 4 0 0 0 4-4 3 3 0 0 1 3-3M7 12h3a4 4 0 0 1 4 4 3 3 0 0 0 3 3"/></svg></span>
          <h3>Routing without limits</h3>
          <p>Multi-WAN, policy routing, VLANs, traffic shaping, CARP high availability and the pf packet filter on a modern FreeBSD 16 network stack.</p>
          <div class="route-viz" aria-hidden="true"><span>WAN 1</span><span>WAN 2</span><i></i><b>pf</b><i></i><span>LAN</span><span>VLAN 20</span><span>DMZ</span></div>
        </article>

        <article class="tile t-security">
          <div class="radar" aria-hidden="true"><div class="radar-sweep"></div><span class="node n1"></span><span class="node n2"></span><span class="node n3"></span><div class="radar-core"></div></div>
          <h3>See the threat. Stop it at the edge.</h3>
          <div class="sec-list"><span><b>Suricata 8</b>IDS / IPS</span><span><b>CrowdSec</b>Threat intel</span><span><b>pfBlockerNG</b>IP + DNS lists</span><span><b>ACME</b>Certificates</span></div>
        </article>

        <article class="tile t-vpn">
          <h3>Every kind of VPN</h3>
          <p>Traditional standards and modern mesh, all on the same interfaces, rules and routing.</p>
          <div class="vpn-chips">{vpns.map((v) => <span style={`--c:${v.color}`}><i></i>{v.name}</span>)}</div>
        </article>

        <article class="tile t-be">
          <h3>Upgrade boldly. Roll back calmly.</h3>
          <p>ZFS boot environments snapshot the whole OS before an upgrade. Pick a known-good one from the WebUI or boot menu.</p>
          <div class="be-mini" aria-hidden="true">
            <div class="on"><i></i><span>Current system</span><b>Running</b></div>
            <div><i></i><span>Before system update</span><b>Activate</b></div>
            <div><i></i><span>Known-good baseline</span><b>Activate</b></div>
          </div>
          <a href={DOCS + '/operations/zfs-boot-environments/'}>Boot environments →</a>
        </article>

        <article class="tile t-cloud">
          <span class="t-tag">Official cloud images</span>
          <h3>Boot the firewall. Skip the installer.</h3>
          <ul class="ticks"><li>QCOW2 and raw GPT</li><li>NoCloud, ConfigDrive, and OpenStack</li><li>QEMU guest agent included</li></ul>
          <a href="/download/?image=ufs&amp;format=qcow2#release-channels">Choose a cloud image →</a>
        </article>

        <article class="tile t-pkg">
          <span class="t-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17.5 14v7M14 17.5h7"/></svg></span>
          <h3>A curated package catalog</h3>
          <p>Capabilities, support status and resource impact shown before you install, with native WebUI integration.</p>
        </article>

        <article class="tile t-privacy">
          <h3>Yours. Not ours.</h3>
          <ul class="ticks"><li>Apache-2.0, every line</li><li>No accounts or activation</li><li>No telemetry or phone-home</li><li>Signed updates</li></ul>
        </article>
      </div>
    </div>
  </section>

  <section class="family">
    <div class="wrap family-grid">
      <div class="family-copy">
        <span class="eyebrow">The FreeSense family</span>
        <div class="family-app"><img src={netspider.logo} alt="" width="56" height="56" /><div><h2>NetSpider</h2><span class="family-ver"><i></i><span data-live="netspider-version">v{netspider.version}</span> · Windows</span></div></div>
        <p class="family-tag">{netspider.tagline}</p>
        <p>{netspider.summary}</p>
        <div class="family-actions"><a href="/apps/netspider" class="btn family-btn">Explore NetSpider →</a><a href="/apps/netspider#download" class="btn btn-ghost">Download</a></div>
      </div>
      <a href="/apps/netspider" class="family-shot" aria-label="NetSpider spider-web view">
        <img src={netspider.hero} alt="NetSpider spider-web view of a network" loading="lazy" />
      </a>
    </div>
  </section>

  <section class="news-section">
    <div class="wrap">
      <div class="heading split">
        <div><span class="eyebrow">Latest news</span><h2>Fresh from the project.</h2></div>
        <a href="/news" class="btn btn-ghost">All news →</a>
      </div>
      <div class="news-grid">
        {latestNews.map((post) => (
          <a href={`/news/${post.slug}`} class="news-card">
            {post.image && <img src={post.image} alt="" loading="lazy" />}
            <div class="news-meta"><span>{post.tag}</span><time datetime={post.date}>{formatDate(post.date)}</time></div>
            <h3>{post.title}</h3>
            <p>{post.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap"><div class="cta-box">
      <div><span class="eyebrow">Ready when you are</span><h2>Take control of your edge.</h2><p>Install FreeSense on your own hardware, a virtual machine, or a cloud disk. No license keys. No accounts. No artificial limits.</p></div>
      <div class="cta-actions"><a href="/download" class="btn btn-primary">Download FreeSense</a><a href={GITHUB} class="btn btn-ghost" rel="noopener">View the source ↗</a></div>
    </div></div>
  </section>
</Base>

<script>
  import '../scripts/live';
</script>

<style>
  .heading h2 { font-size: clamp(34px, 4vw, 52px); letter-spacing: -.045em; margin: 10px 0 0; }
  .heading.split { display: flex; justify-content: space-between; align-items: end; gap: 50px; margin-bottom: 40px; }
  .heading.split > p { color: var(--muted); max-width: 460px; margin: 0; font-size: 15.5px; }
  .heading.centered { text-align: center; max-width: 760px; margin: 0 auto 46px; }
  .heading.centered > p { color: var(--muted); margin: 16px auto 0; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 0 rgba(62,207,142,.5); animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 9px rgba(62,207,142,0); } 100% { box-shadow: 0 0 0 0 rgba(62,207,142,0); } }

  /* Live status bar */
  .pulse { padding: 0; background: rgba(17,23,32,.92); border-bottom: 1px solid var(--border); }
  .pulse-inner { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .pulse-item { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'dot label' 'dot value' 'dot meta'; column-gap: 11px; padding: 18px 18px; border-left: 1px solid var(--border); color: var(--text); min-width: 0; transition: background .15s; }
  .pulse-item:last-child { border-right: 1px solid var(--border); }
  .pulse-item:hover { background: rgba(255,255,255,.025); color: var(--text); }
  .pulse-dot { grid-area: dot; margin-top: 5px; width: 8px; height: 8px; border-radius: 50%; background: #7d8aa0; }
  .pulse-dot.good { background: var(--good); box-shadow: 0 0 0 4px rgba(62,207,142,.12); }
  .pulse-dot.dev { background: #f6c85f; box-shadow: 0 0 0 4px rgba(246,200,95,.12); }
  .pulse-dot.ns { background: #22c7f0; box-shadow: 0 0 0 4px rgba(34,199,240,.12); }
  .pulse-item small { grid-area: label; color: #7d8aa0; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; }
  .pulse-item b { grid-area: value; font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pulse-item b code { background: none; border: 0; padding: 0; font-size: 14px; color: var(--text); }
  .pulse-item em { grid-area: meta; font-style: normal; color: var(--muted-2); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 18px; }

  /* Live pipeline */
  .live { padding: 100px 0 90px; }
  .channels { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .channel { position: relative; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 20px; padding: 28px; background: linear-gradient(160deg, #1a2230, #141a24); overflow: hidden; min-width: 0; }
  .channel::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--coral-hi), transparent); }
  .channel.devel::before { background: linear-gradient(90deg, #f6c85f, var(--good), transparent); }
  .channel header { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
  .ch-badge { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--good); border: 1px solid rgba(62,207,142,.35); background: rgba(62,207,142,.08); border-radius: 999px; padding: 4px 10px; white-space: nowrap; }
  .devel .ch-badge { color: #f6c85f; border-color: rgba(246,200,95,.35); background: rgba(246,200,95,.08); }
  .ch-title { text-align: right; }
  .ch-title strong { display: block; font-size: 40px; line-height: 1; letter-spacing: -.04em; }
  .ch-title span { color: var(--muted-2); font-size: 13px; white-space: nowrap; }
  .ch-changes { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 11px; flex: 1; align-content: start; }
  .ch-changes :global(li) { display: flex; gap: 12px; align-items: baseline; color: #cdd5df; font-size: 15px; line-height: 1.45; min-width: 0; }
  .ch-changes :global(li > span:last-child) { min-width: 0; overflow-wrap: anywhere; }
  .ch-changes :global(li a) { color: var(--muted-2); font-size: 13px; }
  .ch-changes :global(li.pkg) { color: var(--muted); font-size: 14px; }
  .ch-changes :global(li.pkg code) { font-size: 11.5px; padding: 1px 5px; }
  .ch-changes :global(li.more), .ch-changes :global(li.empty) { color: var(--muted-2); font-size: 13.5px; padding-left: 2px; }
  .ch-changes .skel { flex: 1; }
  .ch-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; }
  .ch-stats:empty { display: none; }
  .ch-stats :global(div) { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: rgba(13,17,23,.4); }
  .ch-stats :global(b) { display: block; font-size: 22px; letter-spacing: -.02em; }
  .ch-stats :global(span) { color: var(--muted-2); font-size: 12px; line-height: 1.35; display: block; }
  .ch-images { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .ch-images :global(span) { font: 11px var(--mono); color: #aeb9c8; border: 1px solid #34425a; border-radius: 6px; padding: 3px 8px; background: #182131; }
  .channel footer { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 14px; font-weight: 600; }

  .live-row { display: grid; grid-template-columns: 1.35fr 1fr; gap: 18px; margin-top: 18px; }
  .activity, .verify { border: 1px solid var(--border); border-radius: 20px; padding: 26px 28px; background: #151c27; min-width: 0; }
  .panel-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
  .panel-head h3 { margin: 0; font-size: 19px; }
  .panel-head a { font-size: 13px; color: var(--muted); }
  .act-list { list-style: none; margin: 0; padding: 0; position: relative; }
  .act-list::before { content: ''; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1px; background: var(--border-2); }
  .act-list :global(li) { position: relative; display: flex; gap: 16px; padding: 10px 0; }
  .act-list :global(.act-dot) { flex: none; width: 9px; height: 9px; margin-top: 7px; border-radius: 50%; background: #151c27; border: 2px solid var(--coral-hi); z-index: 1; }
  .act-list :global(li:first-child .act-dot) { background: var(--coral-hi); box-shadow: 0 0 0 4px rgba(234,79,45,.15); }
  .act-list :global(.act-body) { min-width: 0; flex: 1; }
  .act-list :global(.act-msg) { display: block; color: var(--text); font-size: 15px; line-height: 1.4; overflow-wrap: anywhere; }
  .act-list :global(.act-msg:hover) { color: var(--coral-hi); }
  .act-list :global(.act-meta) { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 4px; font-size: 12px; color: var(--muted-2); }
  .act-list :global(.act-meta a) { color: var(--muted); }
  .act-list :global(.act-repo) { font-weight: 600; color: #cdd5df !important; }
  .act-list :global(.act-meta code) { font-size: 11px; padding: 1px 5px; }

  .verify p { color: var(--muted); font-size: 14.5px; margin: 0 0 18px; }
  .prov { display: grid; gap: 8px; }
  .prov :global(a), .prov-skel { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; background: rgba(13,17,23,.45); color: var(--text); font-size: 14px; }
  .prov :global(a:hover) { border-color: var(--border-2); color: var(--text); }
  .prov :global(code) { font-size: 12px; color: var(--good); border-color: rgba(62,207,142,.25); background: rgba(62,207,142,.06); }
  .pipeline-mini { display: flex; align-items: center; gap: 8px; margin: 20px 0 14px; font: 12px var(--mono); color: var(--muted); flex-wrap: wrap; }
  .pipeline-mini span { border: 1px solid var(--border-2); border-radius: 6px; padding: 4px 9px; }
  .pipeline-mini i { font-style: normal; color: var(--coral-hi); }
  .verify-link { font-size: 14px; font-weight: 600; }

  /* Platform bento */
  .platform { padding: 100px 0; background: #111720; border-block: 1px solid var(--border); }
  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .tile { position: relative; border: 1px solid var(--border); border-radius: 20px; padding: 28px; background: linear-gradient(150deg, #1a2230, #151c26); overflow: hidden; min-width: 0; transition: border-color .2s, transform .2s; }
  .tile:hover { border-color: #48556a; transform: translateY(-3px); }
  .tile h3 { font-size: 22px; margin: 0 0 10px; letter-spacing: -.02em; }
  .tile p { color: var(--muted); font-size: 15px; margin: 0; }
  .tile > a { display: inline-block; margin-top: 16px; font-size: 14px; font-weight: 600; }
  .t-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 11px; background: var(--coral-soft); color: var(--coral-hi); margin-bottom: 22px; }
  .t-icon svg { width: 23px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .t-route { grid-column: span 4; }
  .t-security { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; }
  .t-vpn { grid-column: span 2; }
  .t-be { grid-column: span 2; }
