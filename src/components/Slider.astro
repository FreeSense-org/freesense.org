---
// Full-width homepage hero carousel. Crossfades between slides, auto-advances,
// pauses on hover/focus/hidden tab, supports swipe and arrow keys, and never
// autoplays under reduced motion. Live values are filled by src/scripts/live.ts.
export interface Slide {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  accent?: string;
  body: string;
  href: string;
  cta: string;
  secondary?: { href: string; label: string };
  image?: string;
  imageAlt?: string;
  visual?: 'dashboard' | 'devel' | 'stable' | 'cloud' | 'arm';
  theme?: 'coral' | 'spider' | 'green' | 'blue';
}
interface Props { slides: Slide[]; interval?: number }
const { slides, interval = 8000 } = Astro.props;
---

<section class="hero-slider" aria-label="Highlights" aria-roledescription="carousel" data-interval={interval}>
  <div class="hs-stage">
    {slides.map((s, i) => (
      <article class:list={['hs-slide', `theme-${s.theme ?? 'coral'}`, { active: i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${s.label}`} aria-hidden={i === 0 ? 'false' : 'true'} data-slide={s.id}>
        <div class="hs-bg" aria-hidden="true"></div>
        <div class="wrap hs-grid">
          <div class="hs-copy">
            <span class="hs-eyebrow"><i></i>{s.eyebrow}</span>
            {i === 0 ? <h1>{s.title}{s.accent && <><br /><span>{s.accent}</span></>}</h1>
                     : <h2>{s.title}{s.accent && <><br /><span>{s.accent}</span></>}</h2>}
            <p>{s.body}</p>
            <div class="hs-actions">
              <a href={s.href} class="btn hs-btn" tabindex={i === 0 ? 0 : -1}>{s.cta} <span aria-hidden="true">→</span></a>
              {s.secondary && <a href={s.secondary.href} class="btn btn-ghost" tabindex={i === 0 ? 0 : -1}>{s.secondary.label}</a>}
            </div>
          </div>

          <div class="hs-visual">
            {s.image && <div class="v-shot"><img src={s.image} alt={s.imageAlt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} /></div>}

            {s.visual === 'dashboard' && (
              <div class="v-dash" aria-label="FreeSense dashboard preview">
                <div class="vd-chrome">
                  <span class="vd-brand"><b>F<span>S</span></b> FreeSense</span>
                  <span class="vd-nav">System&nbsp;&nbsp; Interfaces&nbsp;&nbsp; Firewall&nbsp;&nbsp; VPN</span>
                  <span class="vd-dot"></span>
                </div>
                <div class="vd-body">
                  <div class="vd-title"><span>Status</span> / Dashboard <small>Up to date · <b data-live="stable-version">1.0</b></small></div>
                  <div class="vd-metrics">
                    <div><span>WAN</span><strong>2.5 Gb/s</strong><small>Online</small></div>
                    <div><span>Threats blocked</span><strong>1,284</strong><small>Last 24 hours</small></div>
                    <div><span>VPN tunnels</span><strong>08</strong><small>All healthy</small></div>
                  </div>
                  <div class="vd-grid">
                    <div class="vd-panel">
                      <div class="vd-head"><strong>Live traffic</strong><span>24 hours</span></div>
                      <svg class="vd-chart" viewBox="0 0 520 175" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="vdFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff6243" stop-opacity=".38"/><stop offset="1" stop-color="#ff6243" stop-opacity="0"/></linearGradient></defs>
                        <path class="vd-gridline" d="M0 35H520M0 87H520M0 139H520"/>
                        <path class="vd-area" d="M0 152 C35 145 42 96 76 108 S130 155 162 99 S211 82 238 116 S290 142 317 66 S369 52 397 91 S452 135 520 38 V175 H0Z"/>
                        <path class="vd-line" d="M0 152 C35 145 42 96 76 108 S130 155 162 99 S211 82 238 116 S290 142 317 66 S369 52 397 91 S452 135 520 38"/>
                      </svg>
                    </div>
                    <div class="vd-panel vd-services">
                      <div class="vd-head"><strong>Services</strong><span class="ok">● Healthy</span></div>
                      {['Suricata IDS', 'WireGuard', 'Kea DHCP', 'Unbound DNS'].map((name) => (
                        <div class="vd-service"><i>✓</i><span>{name}</span><small>Running</small></div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )}

            {s.visual === 'devel' && (
              <div class="v-term">
                <div class="vt-head"><span class="vt-dots"><i></i><i></i><i></i></span><span>freesense · 1.1 development</span></div>
                <div class="vt-body">
                  <div class="vt-row"><span class="vt-k">latest build</span><span class="vt-v"><b data-live="devel-version">1.1</b> · <span data-live="devel-ago">recently</span></span></div>
                  <div class="vt-row"><span class="vt-k">arm64 build</span><span class="vt-v" data-live="arm-ago">recently</span></div>
                  <div class="vt-row"><span class="vt-k">freebsd pin</span><span class="vt-v"><code data-live="freebsd-pin">pinned</code></span></div>
                  <div class="vt-sep">what changed</div>
                  <ul class="vt-changes" data-live="devel-changes">
                    <li><span class="chg chg-build">Build</span><span>New builds land automatically after the nightly run</span></li>
                  </ul>
                </div>
              </div>
            )}

            {s.visual === 'stable' && (
              <div class="v-card v-stable">
                <span class="v-label">STABLE CHANNEL</span>
                <strong data-live="stable-version">1.0</strong>
                <small>Released <span data-live="stable-ago">recently</span></small>
                <div class="v-chips"><span>✓ Signed</span><span>✓ Supported</span><span>✓ ZFS + UFS</span></div>
              </div>
            )}

            {s.visual === 'cloud' && (
              <div class="v-card v-cloud">
                {['Proxmox', 'OpenStack', 'QEMU / KVM', 'bhyve'].map((p) => <span>{p}</span>)}
                <div class="v-disks"><b>UFS</b><b>ZFS</b><small>QCOW2 · RAW GPT · BIOS · UEFI</small></div>
              </div>
            )}

            {s.visual === 'arm' && (
              <div class="v-card v-arm">
                <div class="v-board"><i></i><i></i><i></i><span>ARM64</span></div>
                <div class="v-chips"><span>Generic UEFI</span><span>Pi 4B</span><span>Pi 5 D0</span></div>
                <small>Experimental · labs and testing</small>
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="wrap hs-controls">
    <div class="hs-tabs">
      {slides.map((s, i) => (
        <button type="button" class="hs-tab" data-index={i} aria-label={`Show slide ${i + 1}: ${s.label}`} aria-current={i === 0 ? 'true' : 'false'}>
          <span class="hs-tab-label">{s.label}</span><span class="hs-bar"><i></i></span>
        </button>
      ))}
    </div>
    <div class="hs-arrows">
      <button type="button" class="hs-arrow" data-dir="-1" aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
      <button type="button" class="hs-arrow" data-dir="1" aria-label="Next slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
    </div>
  </div>
</section>

<script>
  for (const slider of document.querySelectorAll<HTMLElement>('.hero-slider')) {
    const stage = slider.querySelector<HTMLElement>('.hs-stage')!;
    const slides = [...slider.querySelectorAll<HTMLElement>('.hs-slide')];
    const tabs = [...slider.querySelectorAll<HTMLButtonElement>('.hs-tab')];
    const interval = Number(slider.dataset.interval) || 8000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;
    let paused = false;

    const restart = () => {
      window.clearTimeout(timer);
      slider.style.setProperty('--slide-ms', `${interval}ms`);
      slider.classList.remove('running');
      void slider.offsetWidth; // restart the progress-bar animation
      if (reduced || paused || document.hidden) return;
      slider.classList.add('running');
      timer = window.setTimeout(() => go(index + 1), interval);
    };
    const go = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.classList.toggle('active', on);
        slide.setAttribute('aria-hidden', String(!on));
        slide.querySelectorAll('a').forEach((a) => (a.tabIndex = on ? 0 : -1));
      });
      tabs.forEach((tab, i) => tab.setAttribute('aria-current', String(i === index)));
      restart();
    };
    const pause = (value: boolean) => { paused = value; restart(); };

    slider.querySelectorAll<HTMLButtonElement>('.hs-arrow').forEach((b) => b.addEventListener('click', () => go(index + Number(b.dataset.dir))));
    tabs.forEach((tab) => tab.addEventListener('click', () => go(Number(tab.dataset.index))));
    stage.addEventListener('mouseenter', () => pause(true));
    stage.addEventListener('mouseleave', () => pause(slider.contains(document.activeElement)));
    slider.addEventListener('focusin', () => pause(true));
    slider.addEventListener('focusout', (e) => { if (!slider.contains(e.relatedTarget as Node)) pause(false); });
    slider.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });
    document.addEventListener('visibilitychange', restart);

    let startX = 0;
    let startY = 0;
    stage.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) go(index + (dx < 0 ? 1 : -1));
    });

    restart();
  }
</script>

<style>
  .hero-slider { position: relative; padding: 0; border-bottom: 1px solid var(--border); overflow: hidden; }
  .hs-stage { display: grid; touch-action: pan-y; }
  .hs-slide { grid-area: 1 / 1; position: relative; min-height: min(720px, calc(100vh - 76px)); display: flex; align-items: center; padding: 70px 0 130px; opacity: 0; visibility: hidden; transition: opacity .7s ease, visibility 0s linear .7s; }
  .hs-slide.active { opacity: 1; visibility: visible; transition: opacity .7s ease, visibility 0s; z-index: 1; }
  .hs-bg { position: absolute; inset: 0; pointer-events: none; }
  .hs-bg::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, black, transparent 75%); }
  .theme-coral .hs-bg { background: radial-gradient(45% 60% at 78% 30%, rgba(234,79,45,.24), transparent 70%), radial-gradient(40% 50% at 10% 90%, rgba(54,111,175,.14), transparent 70%); }
  .theme-spider .hs-bg { background: radial-gradient(45% 60% at 80% 25%, rgba(194,58,214,.26), transparent 70%), radial-gradient(45% 55% at 12% 85%, rgba(34,199,240,.2), transparent 70%); }
  .theme-green .hs-bg { background: radial-gradient(45% 60% at 78% 30%, rgba(62,207,142,.18), transparent 70%), radial-gradient(40% 50% at 10% 90%, rgba(234,79,45,.12), transparent 70%); }
  .theme-blue .hs-bg { background: radial-gradient(45% 60% at 78% 30%, rgba(80,183,255,.2), transparent 70%), radial-gradient(40% 50% at 10% 90%, rgba(167,139,250,.14), transparent 70%); }

  .hs-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 60px; align-items: center; width: 100%; }
  .hs-copy > * { transform: translateY(14px); opacity: 0; transition: transform .7s cubic-bezier(.2,.7,.2,1), opacity .7s; }
  .active .hs-copy > * { transform: none; opacity: 1; }
  .active .hs-copy > :nth-child(2) { transition-delay: .06s; } .active .hs-copy > :nth-child(3) { transition-delay: .12s; } .active .hs-copy > :nth-child(4) { transition-delay: .18s; }
  .hs-visual { min-width: 0; display: grid; place-items: center; transform: scale(.97) translateY(10px); opacity: 0; transition: transform .9s cubic-bezier(.2,.7,.2,1), opacity .9s; }
  .active .hs-visual { transform: none; opacity: 1; transition-delay: .1s; }

  .hs-eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 6px 13px; border-radius: 999px; color: var(--coral-hi); background: var(--coral-soft); border: 1px solid rgba(255,107,74,.3); }
  .hs-eyebrow i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 18%, transparent); animation: blink 2s ease-in-out infinite; }
  .theme-spider .hs-eyebrow { color: #7fe1f8; background: rgba(34,199,240,.1); border-color: rgba(34,199,240,.35); }
  .theme-green .hs-eyebrow { color: var(--good); background: rgba(62,207,142,.1); border-color: rgba(62,207,142,.35); }
  .theme-blue .hs-eyebrow { color: #7cc8ff; background: rgba(80,183,255,.1); border-color: rgba(80,183,255,.35); }
  @keyframes blink { 50% { opacity: .45; } }

  .hs-slide h1, .hs-slide h2 { font-size: clamp(42px, 5.4vw, 74px); line-height: 1; letter-spacing: -.055em; margin: 24px 0 22px; }
  .hs-slide h1 span, .hs-slide h2 span { color: var(--coral-hi); }
  .theme-spider h2 span { background: linear-gradient(100deg, #22c7f0, #c23ad6); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .theme-green h2 span { color: var(--good); }
  .theme-blue h2 span { color: #7cc8ff; }
  .hs-copy p { color: var(--muted); font-size: 18.5px; line-height: 1.65; margin: 0; max-width: 560px; }
  .hs-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hs-btn { background: linear-gradient(135deg, var(--coral-hi), var(--coral)); color: #fff; box-shadow: 0 12px 30px rgba(234,79,45,.24); }
  .hs-btn:hover { color: #fff; transform: translateY(-2px); }
  .theme-spider .hs-btn { background: linear-gradient(120deg, #1ab6e0, #a92fc4); box-shadow: 0 12px 30px rgba(34,199,240,.22); }
  .theme-green .hs-btn { background: linear-gradient(135deg, #3ecf8e, #23a56c); }
  .theme-blue .hs-btn { background: linear-gradient(135deg, #50b7ff, #2f7fd6); }

  /* Visuals */
  .v-shot { width: 100%; border-radius: 16px; overflow: hidden; border: 1px solid rgba(120,140,170,.25); box-shadow: 0 40px 100px rgba(0,0,0,.55), 0 0 80px rgba(34,199,240,.14); transform: perspective(1400px) rotateY(-4deg); }
  .v-shot img { display: block; width: 100%; height: auto; }

  .v-dash { width: 100%; border: 1px solid #344257; border-radius: 15px; background: #111720; box-shadow: 0 40px 100px rgba(0,0,0,.48), 0 0 0 9px rgba(255,255,255,.015); transform: perspective(1200px) rotateY(-4deg) rotateX(1deg); }
  .vd-chrome { height: 46px; padding: 0 16px; display: flex; align-items: center; gap: 22px; border-bottom: 1px solid #293447; background: #151c27; border-radius: 15px 15px 0 0; font-size: 9px; color: #8794a8; }
  .vd-brand { color: #dfe5ed; font-size: 12px; white-space: nowrap; } .vd-brand b { font-size: 16px; margin-right: 5px; } .vd-brand b span { color: var(--coral-hi); }
  .vd-nav { flex: 1; text-align: center; } .vd-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); }
  .vd-body { padding: 18px; }
  .vd-title { font-weight: 600; font-size: 13px; } .vd-title > span { color: var(--coral-hi); } .vd-title small { float: right; color: var(--good); font-weight: 500; font-size: 9.5px; }
  .vd-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin: 15px 0 10px; }
  .vd-metrics div { border: 1px solid #293548; border-radius: 9px; padding: 12px; background: #192230; }
  .vd-metrics span, .vd-metrics small { display: block; font-size: 8px; color: #8e9caf; } .vd-metrics strong { display: block; font-size: 18px; margin: 2px 0; } .vd-metrics small { color: var(--good); }
  .vd-grid { display: grid; grid-template-columns: 1.55fr .8fr; gap: 9px; }
  .vd-panel { border: 1px solid #293548; background: #171f2b; border-radius: 9px; padding: 12px; min-width: 0; }
  .vd-head { display: flex; justify-content: space-between; font-size: 9px; color: #738198; } .vd-head strong { color: #dfe5ed; font-size: 10px; } .vd-head .ok { color: var(--good); }
  .vd-chart { width: 100%; height: 130px; overflow: visible; } .vd-gridline { stroke: #2a3547; stroke-width: 1; } .vd-area { fill: url(#vdFill); }
  .vd-line { fill: none; stroke: var(--coral-hi); stroke-width: 2.3; vector-effect: non-scaling-stroke; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .active .vd-line { animation: draw 2.2s ease forwards .3s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .vd-service { display: grid; grid-template-columns: 18px 1fr auto; align-items: center; gap: 5px; padding: 9px 0; border-bottom: 1px solid #273143; font-size: 9px; } .vd-service:last-child { border: 0; }
  .vd-service i { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: rgba(62,207,142,.13); color: var(--good); font-size: 8px; font-style: normal; } .vd-service small { color: #718095; font-size: 7px; }

  .v-term { width: 100%; max-width: 560px; border: 1px solid #2f5a48; border-radius: 14px; background: #0c1310; box-shadow: 0 40px 100px rgba(0,0,0,.5), 0 0 70px rgba(62,207,142,.1); font-family: var(--mono); overflow: hidden; }
  .vt-head { display: flex; align-items: center; gap: 14px; padding: 12px 16px; background: #111c17; border-bottom: 1px solid #22392f; color: #7fae98; font-size: 12px; }
  .vt-dots { display: flex; gap: 6px; } .vt-dots i { width: 9px; height: 9px; border-radius: 50%; background: #2a4a3c; }
  .vt-body { padding: 18px 20px 20px; font-size: 13px; }
  .vt-row { display: flex; justify-content: space-between; gap: 14px; padding: 6px 0; border-bottom: 1px dashed #1f3329; }
  .vt-k { color: #5f8a76; } .vt-v { color: #d8f5e7; text-align: right; } .vt-v b { color: var(--good); } .vt-v code { background: none; border: 0; padding: 0; color: #d8f5e7; }
  .vt-sep { color: #5f8a76; margin: 16px 0 8px; text-transform: uppercase; letter-spacing: .1em; font-size: 10.5px; }
  .vt-changes { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-family: var(--font); }
  .vt-changes :global(li) { display: flex; gap: 10px; align-items: baseline; color: #cfe3d9; font-size: 13.5px; line-height: 1.45; }
  .vt-changes :global(a) { color: var(--good); }

  .v-card { width: 100%; max-width: 470px; border: 1px solid #354157; border-radius: 18px; background: rgba(17,23,32,.78); padding: 30px; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.4); }
  .v-label { color: var(--good); font: 11px var(--mono); letter-spacing: .12em; }
  .v-stable strong { display: block; font-size: clamp(84px, 10vw, 136px); line-height: 1; letter-spacing: -.06em; margin: 14px 0 8px; background: linear-gradient(180deg, #fff, #ff8c70); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .v-stable small { display: block; color: var(--muted-2); font-size: 13px; margin-bottom: 18px; }
  .v-chips { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .v-chips span { font-size: 13px; color: #cbd3de; border: 1px solid #3b485c; border-radius: 999px; padding: 4px 12px; background: #1a2230; }
  .v-cloud { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .v-cloud > span { padding: 18px; border: 1px solid #354157; border-radius: 12px; background: #171f2b; font-weight: 600; }
  .v-disks { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .v-disks b { font: 700 18px var(--mono); padding: 10px 18px; border-radius: 10px; border: 1px solid rgba(80,183,255,.45); color: #7cc8ff; background: rgba(80,183,255,.08); }
  .v-disks small { width: 100%; color: var(--muted-2); font: 11px var(--mono); }
  .v-board { position: relative; height: 150px; margin: 0 auto 20px; max-width: 260px; border-radius: 14px; background: linear-gradient(135deg, #1f6f4e, #134a35); border: 1px solid #2f8a63; display: grid; place-items: center; }
  .v-board span { font: 700 22px var(--mono); color: #e7fff3; padding: 14px 18px; border-radius: 8px; background: #0f1a15; border: 1px solid #3aa577; }
  .v-board i { position: absolute; width: 22px; height: 14px; border-radius: 3px; background: #c9d2dc; right: -8px; }
  .v-board i:nth-child(1) { top: 26px; } .v-board i:nth-child(2) { top: 66px; } .v-board i:nth-child(3) { top: 106px; }
  .v-arm small { display: block; color: #f6c85f; font-size: 12px; margin-top: 14px; }

  /* Controls */
  .hs-controls { position: absolute; left: 0; right: 0; bottom: 34px; z-index: 3; display: flex; align-items: center; gap: 24px; }
  .hs-tabs { flex: 1; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 12px; }
  .hs-tab { font: inherit; background: none; border: 0; padding: 8px 0 0; color: var(--muted-2); text-align: left; cursor: pointer; font-size: 13px; font-weight: 500; transition: color .2s; }
  .hs-tab:hover, .hs-tab[aria-current="true"] { color: var(--text); }
  .hs-tab-label { display: block; margin-bottom: 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hs-bar { display: block; height: 3px; border-radius: 3px; background: rgba(255,255,255,.12); overflow: hidden; }
  .hs-bar i { display: block; height: 100%; width: 100%; background: var(--coral-hi); transform: scaleX(0); transform-origin: left; }
  .hs-tab[aria-current="true"] .hs-bar i { transform: scaleX(1); }
  .running .hs-tab[aria-current="true"] .hs-bar i { animation: progress var(--slide-ms, 8000ms) linear forwards; }
  @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hs-arrows { display: flex; gap: 8px; }
  .hs-arrow { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border-2); background: rgba(23,31,43,.8); color: var(--text); display: grid; place-items: center; cursor: pointer; transition: border-color .15s; }
  .hs-arrow:hover { border-color: var(--coral); }
  .hs-arrow svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  @media (prefers-reduced-motion: reduce) {
    .hs-slide, .hs-copy > *, .hs-visual { transition: none !important; }
    .vd-line { stroke-dashoffset: 0; animation: none !important; }
