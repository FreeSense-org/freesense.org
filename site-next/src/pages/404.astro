---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — FreeSense" description="This page does not exist.">
  <section class="page-hero center" style="min-height:50vh">
    <div class="wrap narrow">
      <span class="eyebrow">404</span>
      <h1>This page took a different route.</h1>
      <p class="lead-muted">The address may be old or mistyped. These are good places to continue:</p>
      <div class="hero-ctas justify-content-center mt-4">
        <a class="btn-pill btn-grad" href="/">Home</a>
        <a class="btn-pill btn-ghost" href="/download/">Download</a>
        <a class="btn-pill btn-ghost" href="/news/">News</a>
      </div>
    </div>
  </section>
</Base>
