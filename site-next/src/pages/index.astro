---
import Base from '../layouts/Base.astro';
import IsoScene from '../components/IsoScene.astro';
import { news, formatDate } from '../../../src/data/news';
import { apps } from '../../../src/data/apps';
import { DOCS, GITHUB } from '../data/site';

const netspider = apps.find((a) => a.slug === 'netspider')!;
const [lead, ...others] = news.slice(0, 3);
const leadNumber = lead.title.match(/\b\d+\.\d+(?:\.\d+)?\b/)?.[0];

const marks = [
  { name: 'FreeBSD' }, { name: 'Proxmox', style: 'm-light' }, { name: 'QEMU / KVM', style: 'm-wide' },
  { name: 'OpenStack' }, { name: 'bhyve', style: 'm-mono' }, { name: 'VMware', style: 'm-light' },
  { name: 'Bare metal', style: 'm-italic' }, { name: 'ARM64', style: 'm-wide' }, { name: 'pf', style: 'm-mono' },
  { name: 'ZFS', style: 'm-wide' }, { name: 'WireGuard', style: 'm-light' }, { name: 'Raspberry Pi' },
];
---

<Base
  title="FreeSense — the open-source firewall you can verify"
  description="FreeSense is an open-source firewall and router built on FreeBSD, with signed installer and cloud images built in public CI. No accounts, no telemetry, no artificial limits."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow reveal">Open source &middot; Built in public</span>
        <h1 class="reveal d1">FreeSense</h1>
        <p class="subtitle reveal d2">The firewall you can verify, from source to image.</p>
        <p class="lead-muted reveal d2">
          FreeSense is a new, open-source firewall and router built on FreeBSD. Every release is built in public CI
          from pinned sources and signed. No accounts, no telemetry, no artificial limits.
        </p>
        <div class="hero-ctas reveal d3">
          <a class="btn-pill btn-grad" href="/download/">Download <span data-live="stable-version">1.1</span></a>
          <a class="btn-pill btn-ghost" href="/freesense/">Explore FreeSense</a>
        </div>
        <div class="hero-meta reveal d3">
          <a href="/download/"><b data-live="stable-version">1.1</b>Stable &middot; supported</a>
          <a href="#live"><b data-live="devel-version">1.2 dev</b>Development &middot; nightly</a>
          <a href="https://github.com/freebsd/freebsd-src" rel="noopener"><b data-live="freebsd-pin">FreeBSD 16</b>Pinned FreeBSD base</a>
        </div>
      </div>
      <div class="hero-art reveal d2"><IsoScene /></div>
    </div>
    <div class="wrap">
      <div class="news-rail reveal d3" data-news-rail aria-roledescription="carousel" aria-label="Latest news">
        <div class="news-rail-head">
          <span class="eyebrow">Latest news</span>
          <div class="news-rail-nav">
            <button type="button" class="rail-btn" data-rail="prev" aria-label="Previous news">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
            </button>
            <button type="button" class="rail-btn" data-rail="next" aria-label="Next news">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <a class="rail-all" href="/news/">All news</a>
          </div>
        </div>
        <div class="news-rail-track" tabindex="0">
          {news.slice(0, 6).map((post) => (
            <a class="rail-card" href={`/news/${post.slug}/`}>
              <span class="rail-meta"><span class="rail-tag">{post.tag}</span><time datetime={post.date}>{formatDate(post.date)}</time></span>
              <span class="rail-title">{post.title}</span>
            </a>
          ))}
        </div>
        <div class="news-rail-progress" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <section class="trusted center" style="padding-top:clamp(16px,3vw,40px)">
    <div class="wrap">
      <h2 class="reveal">Runs where your network lives</h2>
      <ul class="marks" aria-label="Platforms and technologies">
        {marks.map((m, i) => <li class:list={['lmark', m.style, 'reveal', `d${i % 4}`]}>{m.name}</li>)}
      </ul>
    </div>
  </section>

  <section id="why" class="center">
    <div class="wrap">
      <span class="eyebrow reveal">One open distribution</span>
      <h2 class="section-title reveal d1">Why FreeSense?</h2>
      <p class="lead-muted reveal d2">A complete firewall with nothing held back, and a build you can check line by line.</p>
      <div class="why-grid">
        <article class="fs-card tilt reveal d1"><span class="shine"></span>
          <div class="card-head"><svg class="gico" viewBox="0 0 42 42" aria-hidden="true"><defs><linearGradient id="ic1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FF9466"/><stop offset="1" stop-color="#C93A1C"/></linearGradient></defs><path d="M21 5l13 5v10c0 9-6 14-13 17-7-3-13-8-13-17V10z" fill="url(#ic1)"/><path d="M21 5l13 5v6c-8 1-18 0-26-2v-4z" fill="#fff" opacity=".3"/><path d="M15 21l4 4 8-8" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><h3>Verifiable protection</h3></div>
          <p>The pf packet filter on FreeBSD, with every image built in public CI from pinned sources and signed before it reaches you.</p>
        </article>
        <article class="fs-card tilt reveal d2"><span class="shine"></span>
          <div class="card-head"><svg class="gico" viewBox="0 0 42 42" aria-hidden="true"><defs><linearGradient id="ic2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8FB0FF"/><stop offset="1" stop-color="#2E55D6"/></linearGradient></defs><circle cx="21" cy="21" r="15" fill="url(#ic2)"/><ellipse cx="17" cy="14" rx="9" ry="5" fill="#fff" opacity=".35"/><circle cx="21" cy="21" r="5" fill="none" stroke="#fff" stroke-width="3"/><path d="M21 9v4M21 29v4M9 21h4M29 21h4M12.5 12.5l2.8 2.8M26.7 26.7l2.8 2.8M12.5 29.5l2.8-2.8M26.7 15.3l2.8-2.8" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg><h3>Easy to run</h3></div>
          <p>A reworked WebUI with grouped menus and Ctrl+K menu search, plus a REST API for everything you would rather script.</p>
        </article>
        <article class="fs-card tilt reveal d3"><span class="shine"></span>
          <div class="card-head"><svg class="gico" viewBox="0 0 42 42" aria-hidden="true"><defs><linearGradient id="ic3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5BE3B1"/><stop offset="1" stop-color="#14946A"/></linearGradient></defs><rect x="8" y="7" width="26" height="28" rx="7" fill="url(#ic3)"/><rect x="8" y="7" width="26" height="12" rx="7" fill="#fff" opacity=".3"/><path d="M14 18h14M14 24h10M14 30h6" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg><h3>Nothing held back</h3></div>
          <p>One edition with every feature. Apache-2.0, no accounts or activation, no telemetry or phone-home.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="split">
        <div>
          <span class="eyebrow reveal">New in 1.1</span>
          <h2 class="reveal d1">Run it from the WebUI. Or from a script.</h2>
          <p class="lead-muted reveal d2">FreeSense 1.1 replaced 1.0 as the supported Stable line, with a rebuilt interface and new ways to automate it.</p>
          <ul class="ticks reveal d3">
            <li><a href={`${DOCS}/api/overview/`}><span><b>REST API</b> with per-user privileges and a built-in API Explorer.</span></a></li>
            <li><a href={`${DOCS}/releases/whats-new-1.1/`}><span><b>Ctrl+K menu search</b> and grouped top menus across the WebUI.</span></a></li>
            <li><a href={`${DOCS}/configure/interfaces-vlans-bridges/#vxlan`}><span><b>VXLAN interfaces</b> alongside VLANs, bridges and tunnels.</span></a></li>
          </ul>
        </div>
        <div class="split-media reveal d2">
          <div class="panel">
            <div class="panel-bar"><i></i><i></i><i></i><span>System / Boot Environments</span></div>
            <div class="panel-body">
              <div class="be-list" aria-label="Example boot environment list">
                <div class="on"><i></i><span>Current system</span><b>Running</b></div>
                <div><i></i><span>Before system update</span><b>Activate</b></div>
                <div><i></i><span>Known-good baseline</span><b>Activate</b></div>
              </div>
              <p class="mt-3 mb-0" style="font-size:.88rem;color:var(--fs-muted)">ZFS boot environments snapshot the whole OS before an upgrade, so you can roll back from the WebUI or the boot menu.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="split rev">
        <div>
          <span class="eyebrow reveal">Rules you can read</span>
          <h2 class="reveal d1">pf underneath. Clarity on top.</h2>
          <p class="lead-muted reveal d2">Write rules in the WebUI or drive them from the API. Threat Shield filters DNS for the whole network with AdGuard Home.</p>
          <ul class="ticks reveal d3">
            <li><a href={`${DOCS}/packages/threat-shield/`}><span><b>Threat Shield &amp; DNS Protection</b> as an optional package.</span></a></li>
            <li><a href={`${DOCS}/packages/custom-repositories/`}><span><b>Custom package repositories</b>, kept below the official ones.</span></a></li>
            <li><a href={`${DOCS}/base-os/system-administration/`}><span><b>Encrypted remote backups</b> to S3-compatible storage, WebDAV or SFTP.</span></a></li>
          </ul>
        </div>
        <div class="split-media reveal d2">
          <div class="panel">
            <div class="panel-bar"><i></i><i></i><i></i><span>Example ruleset</span></div>
            <div class="panel-body" style="overflow-x:auto">
              <table class="rules">
                <caption class="visually-hidden">Example firewall rules</caption>
                <tbody>
                  <tr><td><span class="tag pass">PASS</span></td><td>LAN net</td><td>any</td><td><code>keep state</code></td></tr>
                  <tr><td><span class="tag block">BLOCK</span></td><td><code>&lt;threats&gt;</code></td><td>WAN</td><td><code>quick</code></td></tr>
                  <tr><td><span class="tag pass">PASS</span></td><td>any</td><td>WAN :51820/udp</td><td>WireGuard</td></tr>
                  <tr><td><span class="tag pass">PASS</span></td><td>VLAN 20</td><td>DNS :53</td><td>Threat Shield</td></tr>
                  <tr><td><span class="tag block">BLOCK</span></td><td>any</td><td>WAN</td><td><code>log</code></td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="live">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow reveal"><i class="live-dot"></i> Live from the pipeline</span>
          <h2 class="section-title reveal d1 mb-0">What just shipped</h2>
        </div>
        <p class="reveal d2">Read live from the signed release feeds and GitHub. Every build is pinned to exact source, ports and FreeBSD revisions you can inspect.</p>
      </div>

      <div class="rel-grid">
        <article class="fs-card channel reveal d1" id="live-stable">
          <span class="state"><span class="dot"></span>Stable &middot; supported</span>
          <div class="ch-title"><strong class="ch-version">1.1</strong><span>released <time class="ch-when">recently</time></span></div>
          <ul class="ch-changes"><li><span class="skel" style="width:88%"></span></li><li><span class="skel" style="width:72%"></span></li><li><span class="skel" style="width:80%"></span></li></ul>
          <p class="live-fallback">The release feed could not be read just now. The <a href={`${DOCS}/releases/stable/`}>Stable release notes</a> list every change.</p>
          <div class="ch-stats"></div>
          <div class="ch-images"></div>
          <footer><a href="/download/" class="btn-pill btn-grad btn-sm-pill">Download Stable</a><a class="text-link" href={`${DOCS}/releases/stable/`}>Release notes &rarr;</a></footer>
        </article>
        <article class="fs-card channel reveal d2" id="live-devel">
          <span class="state"><span class="dot dev"></span>Development &middot; experimental</span>
          <div class="ch-title"><strong class="ch-version">1.2 dev</strong><span>built <time class="ch-when">recently</time></span></div>
          <ul class="ch-changes"><li><span class="skel" style="width:84%"></span></li><li><span class="skel" style="width:90%"></span></li><li><span class="skel" style="width:66%"></span></li></ul>
          <p class="live-fallback">The release feed could not be read just now. See the <a href={`${GITHUB}/freesense/commits/main`} rel="noopener">latest commits on GitHub</a>.</p>
          <div class="ch-stats"></div>
          <div class="ch-images"></div>
          <footer><a href="/download/?channel=devel" class="btn-pill btn-ghost btn-sm-pill">Get the dev build</a><a class="text-link" href={`${GITHUB}/freesense/commits/main`} rel="noopener">All commits &rarr;</a></footer>
        </article>
      </div>

      <div class="status-strip reveal">
        <a href="/download/"><small><span class="dot"></span>Stable</small><b data-live="stable-version">1.1</b><em data-live="stable-ago">supported line</em></a>
        <a href="/download/?channel=devel"><small><span class="dot dev"></span>Development</small><b data-live="devel-version">1.2 dev</b><em data-live="devel-ago">nightly</em></a>
        <a href="/download/?architecture=arm64"><small><span class="dot dev"></span>ARM64 dev build</small><b>aarch64</b><em data-live="arm-ago">experimental</em></a>
        <a href="/netspider/"><small><span class="dot app"></span>NetSpider</small><b data-live="netspider-version">v{netspider.version}</b><em>Windows</em></a>
      </div>

      <div class="live-row">
        <div class="fs-card activity reveal">
          <div class="panel-head"><h3>Development activity</h3><a href={GITHUB} rel="noopener">FreeSense-org on GitHub &nearr;</a></div>
          <ol class="act-list" id="live-activity">
            {[78, 64, 82, 58, 70].map((w) => <li><span class="act-dot"></span><div><span class="skel" style={`width:${w}%`}></span><span class="skel mt-2" style="width:30%;height:9px"></span></div></li>)}
          </ol>
          <p class="live-fallback">Recent commits could not be loaded. Browse <a href={GITHUB} rel="noopener">FreeSense-org on GitHub</a>.</p>
        </div>
        <div class="fs-card reveal d1">
          <div class="panel-head"><h3>Verify the latest build</h3></div>
          <p>The newest Development build was produced from these exact revisions. Pin, build, sign, publish, all in public CI.</p>
          <div class="prov" id="live-provenance">
            {['FreeSense source', 'System ports', 'Optional packages', 'OS definition', 'FreeBSD ports', 'FreeBSD src'].map((label) => (
              <span><span>{label}</span><span class="skel" style="width:84px"></span></span>
            ))}
          </div>
          <a class="text-link" href="/about/#how">How FreeSense is built &rarr;</a>
        </div>
      </div>

      <div class="chain" data-observe>
        <span class="fill"></span>
        <div class="step"><div class="n">1</div><h3>Pin</h3><p>Source, ports, OS definition and FreeBSD fixed to exact commits.</p></div>
        <div class="step"><div class="n">2</div><h3>Build</h3><p>System and packages built from that sealed set in public CI.</p></div>
        <div class="step"><div class="n">3</div><h3>Sign</h3><p>Repositories and images signed with the project key.</p></div>
        <div class="step"><div class="n">4</div><h3>Publish</h3><p>Verified images go up first, then the channel advances.</p></div>
      </div>
    </div>
  </section>

  <section id="packages">
    <div class="wrap split">
      <div>
        <span class="eyebrow reveal">Optional packages</span>
        <h2 class="reveal d1">Threat Shield. The whole network, on a wall.</h2>
        <p class="lead-muted reveal d2">DNS filtering, IP threat lists and country blocking, with a live threat map and a full-screen kiosk board in four styles. One of 34 optional packages that the project builds and signs.</p>
        <div class="hero-ctas mt-4 reveal d3">
          <a class="btn-pill btn-grad" href="/packages/#threat-shield">See Threat Shield</a>
          <a class="btn-pill btn-ghost" href="/packages/">All packages</a>
        </div>
      </div>
      <a class="ns-shot reveal d2" href="/packages/#threat-shield" aria-label="Threat Shield kiosk board">
        <img src="/packages/kiosk-freesense.webp" alt="The Threat Shield kiosk board with attack counters, a world map and live feed" width="1920" height="1080" loading="lazy" />
      </a>
    </div>
  </section>

  <section id="fleet">
    <div class="wrap split rev">
      <a class="ns-shot split-media reveal d2" href="/fleet/" aria-label="FreeSense Fleet dashboard">
        <img src="/fleet/fleet-dashboard.png" alt="The FreeSense Fleet dashboard: all seven firewalls online, availability over 24 hours and a pulse grid per firewall" width="910" height="753" loading="lazy" />
      </a>
      <div>
        <span class="eyebrow reveal">New in 1.2 &middot; Development preview</span>
        <h2 class="reveal d1">FreeSense Fleet. Every firewall, one control centre. All yours.</h2>
        <p class="lead-muted reveal d2">Self-hosted and private: not a cloud service, with no account and nothing sent to FreeSense. Join firewalls with a pasted invitation, watch them on a live dashboard or a wall screen, then back up, update and check them against policies together. Run the controller on your own network or on a public host that you control.</p>
        <div class="hero-ctas mt-4 reveal d3">
          <a class="btn-pill btn-grad" href="/fleet/">See Fleet</a>
          <a class="btn-pill btn-ghost" href={`${DOCS}/1.2/configure/fleet/`}>Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <section id="netspider" class="ns-accent">
    <div class="wrap split">
      <div>
        <span class="eyebrow reveal">The FreeSense family</span>
        <h2 class="reveal d1">NetSpider. {netspider.tagline}</h2>
        <p class="lead-muted reveal d2">{netspider.summary}</p>
        <div class="hero-ctas mt-4 reveal d3">
          <a class="btn-pill btn-grad" href="/netspider/">Explore NetSpider</a>
          <a class="btn-pill btn-ghost" href="/netspider/#download">Download for Windows</a>
        </div>
      </div>
      <a class="ns-shot reveal d2" href="/netspider/" aria-label="NetSpider spider-web view">
        <img src={netspider.hero} alt="NetSpider spider-web view of a network with per-device latency" width="1600" height="900" loading="lazy" />
      </a>
    </div>
  </section>

  <section id="news">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow reveal">Newsroom</span><h2 class="section-title reveal d1 mb-0">Latest from the project</h2></div>
        <a class="btn-pill btn-ghost btn-sm-pill reveal" href="/news/">All news</a>
      </div>
      <div class="news-grid">
        <a class="fs-card news-card lead-card reveal" href={`/news/${lead.slug}/`}>
          <div class="lead-visual" aria-hidden="true">
            {lead.image ? <img src={lead.image} alt="" loading="lazy" /> : <span class="big">{leadNumber ?? lead.tag}</span>}
          </div>
          <span class="cat">{lead.tag}</span> <time datetime={lead.date}>&middot; {formatDate(lead.date)}</time>
          <h3>{lead.title}</h3>
          <p>{lead.summary}</p>
        </a>
        <div class="news-list">
          {others.map((post, i) => (
            <a class:list={['fs-card news-card reveal', `d${i + 1}`]} href={`/news/${post.slug}/`}>
              <span class="cat">{post.tag}</span> <time datetime={post.date}>&middot; {formatDate(post.date)}</time>
              <h3>{post.title}</h3>
              <p>{post.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-box reveal">
        <div>
          <span class="eyebrow">Ready when you are</span>
          <h2>Put FreeSense in front of your network.</h2>
          <p class="lead-muted mb-0">Install on your own hardware, a virtual machine or a cloud disk. Already on 1.0? Upgrade in place; moving from 1.0 to 1.1 is one-way.</p>
        </div>
        <div class="cta-links">
          <a href="/download/">Download FreeSense <small>ISO &amp; cloud images</small></a>
          <a href={`${DOCS}/guides/upgrading-from-1.0/`}>Upgrade from 1.0 <small>Guide</small></a>
          <a href={`${GITHUB}`} rel="noopener">Read the source <small>GitHub</small></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/live.js';
  import '../scripts/news-rail.js';
</script>
