---
import Base from '../layouts/Base.astro';

const GITHUB = 'https://github.com/FreeSense-org';

const features = [
  {
    title: 'Bleeding-edge FreeBSD 16',
    body: 'Built on FreeBSD 16-CURRENT — the newest kernel, drivers and hardware support, with upstream security fixes landing first. You run the modern base, not a years-old snapshot.',
  },
  {
    title: 'Automatic, signed updates',
    body: 'Fresh signed installer images ship on a ~14-day cadence, and package & security updates flow continuously over the air. Stay current in a click — no reinstall, ever.',
  },
  {
    title: 'Open all the way down',
    body: 'The base OS, the web GUI, every package, and the entire build pipeline are public and Apache-2.0. Build your own from source, or run the signed official images. Nothing hidden.',
  },
  {
    title: 'Reproducible builds',
    body: 'The whole OS is rebuilt automatically from a frozen snapshot of upstream FreeBSD sources — deterministic, auditable, no mystery binaries and no vendor lock-in.',
  },
  {
    title: 'Refreshed web GUI',
    body: 'A complete web interface — firewall rules, NAT, VPNs, DHCP/DNS, traffic shaping, monitoring and a full package manager — rebuilt on Bootstrap 5 and dark by default.',
  },
  {
    title: 'Signed repo & channels',
    body: 'Cryptographically signed packages from pkg.freesense.org. Run stable for production or development to ride the latest — switch channels right from the update page.',
  },
];

const build = [
  {
    step: '01',
    title: 'Frozen upstream',
    body: 'Every release pins an exact FreeBSD 16 source snapshot, frozen in place so builds are reproducible and never drift out from under you.',
  },
  {
    step: '02',
    title: 'Automated CI builds',
    body: 'The world, kernel and 570+ packages are compiled from source on clean CI runners — and our own hardware for big releases — then cryptographically signed.',
  },
  {
    step: '03',
    title: 'Signed & delivered',
    body: 'Images and a signed package repo publish to a global CDN. Your firewall pulls updates over the air, verified against our key — no phone-home, no accounts.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-inner">
      <span class="pill">● Open source · Apache-2.0 · community-built</span>
      <h1>The open-source firewall,<br /><span class="accent">rebuilt in the open.</span></h1>
      <p class="lede">
        FreeSense is a free, community-driven firewall &amp; router operating system — an open
        derivative of pfSense® CE, rebuilt from source on the latest FreeBSD with signed, automatic
        updates and zero vendor lock-in.
      </p>
      <div class="hero-cta">
        <a href="/download" class="btn btn-primary">↓ Download FreeSense</a>
        <a href={GITHUB} class="btn btn-ghost" rel="noopener">★ View on GitHub</a>
      </div>
      <p class="hero-note mono">amd64 · UEFI &amp; BIOS · FreeBSD 16 · signed OTA updates</p>
    </div>
  </section>

  <!-- Features -->
  <section id="features">
    <div class="wrap">
      <span class="eyebrow">Why FreeSense</span>
      <h2 class="sec-title">Everything you expect from a serious firewall — and nothing locked away.</h2>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it's built -->
  <section id="build" class="build">
    <div class="wrap">
      <span class="eyebrow">Built in the open</span>
      <h2 class="sec-title">A firewall you can actually audit — and rebuild yourself.</h2>
      <p class="build-lede muted">
        There are no hidden patches and no proprietary tooling. The exact pipeline that produces the
        official images lives in public repositories — clone it and you can reproduce a release
        yourself, byte for byte.
      </p>
      <div class="steps">
        {build.map((b) => (
          <div class="bstep">
            <span class="bnum mono">{b.step}</span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
      <div class="build-stats">
        <div><strong>100%</strong><span>open source</span></div>
        <div><strong>FreeBSD 16</strong><span>current base</span></div>
        <div><strong>570+</strong><span>signed packages</span></div>
        <div><strong>~14&nbsp;days</strong><span>image cadence</span></div>
      </div>
      <p class="build-foot">
        FreeSense is an independent, open derivative of pfSense® CE, built on FreeBSD.
        <a href="/about">Read the story &amp; how it's built →</a>
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta">
    <div class="wrap cta-inner">
      <h2>Ready to try it?</h2>
      <p class="muted">Download an installer image and have a firewall running in minutes.</p>
      <a href="/download" class="btn btn-primary">↓ Get FreeSense</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 96px 0 80px; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  h1 { font-size: clamp(38px, 6vw, 66px); margin: 22px 0 0; }
  .accent { color: var(--coral); }
  .lede { max-width: 680px; font-size: clamp(17px, 2.2vw, 21px); color: var(--muted); margin: 22px 0 0; }
  .hero-cta { display: flex; gap: 14px; margin: 34px 0 0; flex-wrap: wrap; justify-content: center; }
  .hero-note { margin-top: 26px; color: var(--muted-2); font-size: 13.5px; }

  .sec-title { font-size: clamp(26px, 3.4vw, 38px); margin: 12px 0 40px; max-width: 780px; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .card {
    background: var(--ink-3); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 26px 24px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--border-2); transform: translateY(-2px); }
  .card h3 { font-size: 19px; margin: 0 0 10px; }
  .card p { margin: 0; color: var(--muted); font-size: 15.5px; }

  /* How it's built */
  .build { background: var(--ink-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .build .sec-title { margin-bottom: 16px; }
  .build-lede { max-width: 720px; margin: 0 0 40px; font-size: 17px; }
  .muted { color: var(--muted); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .bstep {
    background: var(--ink-3); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 26px 24px; position: relative;
  }
  .bnum { color: var(--coral-hi); font-size: 14px; font-weight: 600; letter-spacing: 0.08em; }
  .bstep h3 { font-size: 18px; margin: 12px 0 8px; }
  .bstep p { margin: 0; color: var(--muted); font-size: 15px; }

  .build-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 32px; }
  .build-stats div {
    background: var(--ink-3); border: 1px solid var(--border);
    border-radius: 12px; padding: 22px; text-align: center;
  }
  .build-stats strong { display: block; font-size: 24px; color: var(--coral-hi); }
  .build-stats span { color: var(--muted); font-size: 14px; }

  .build-foot { margin: 30px 0 0; color: var(--muted-2); font-size: 14.5px; }
  .build-foot a { color: var(--coral-hi); }
  .build-foot a:hover { color: var(--text); }

  .cta-inner { text-align: center; }
  .cta-inner h2 { font-size: clamp(28px, 4vw, 42px); margin: 0 0 10px; }
  .cta-inner p { margin: 0 0 26px; }

  @media (max-width: 880px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr; }
    .build-stats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
