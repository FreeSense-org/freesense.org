---
import Base from '../../layouts/Base.astro';
import { apps } from '../../data/apps';

const app = apps.find((a) => a.slug === 'netspider')!;
const IMG = '/apps/netspider';

const features = [
  { icon: 'web', title: 'Every device, identified', body: 'ARP and IPv6 neighbor sweeps, LLDP, CDP, mDNS, SSDP, SNMP, SMB, TLS and vendor protocols feed an evidence-based classifier with about 170 brand rules.' },
  { icon: 'pulse', title: 'Latency at Layer 2 and 3', body: 'Real MAC-level round trips from high-precision capture timestamps next to ICMP and TCP, including device-to-device timing.' },
  { icon: 'path', title: 'Path Doctor', body: 'Probes every hop from your PC to the internet and turns failures into incidents with a root-cause sentence and a confidence score.' },
  { icon: 'storm', title: 'Storm Center', body: 'Broadcast, multicast and unknown-unicast levels against a learned baseline, with the top sources mapped to their switch port.' },
  { icon: 'wifi', title: 'Wi-Fi ↔ LAN', body: 'Separates the radio hop from the backhaul, and measures true one-way latency across switch and AP on dual-adapter PCs.' },
  { icon: 'export', title: 'Reports and alerts', body: 'Export JSON, CSV, Nmap XML, HTML reports and pcapng. Send alerts to Discord, Slack, webhooks or syslog.' },
];

const tour = [
  { id: 'web', label: 'Spider Web', img: 'spider-web', title: 'Your whole network as a living web', body: 'Every device, every link and its measured latency, animated in real time. Slow links glow amber, failures turn red, and suspected faults are marked on the path.' },
  { id: 'path', label: 'Path Doctor', img: 'app-path-doctor', title: 'Every hop, probed continuously', body: 'The hop chain from this PC to the internet with latency, added latency, loss, jitter and ARP-vs-ICMP per hop. The red link marks exactly where it breaks.' },
  { id: 'incidents', label: 'Incidents', img: 'app-incidents', title: 'Root cause, in plain language', body: 'Correlates the first failing hop, devices that dropped together and switch-port evidence into a single incident with a confidence score.' },
  { id: 'storm', label: 'Storm Center', img: 'app-storm-center', title: 'Catch storms and loops early', body: 'Live broadcast and multicast levels against a learned baseline, top talkers mapped to their switch and port, a loop finder and pcapng recording.' },
  { id: 'devices', label: 'Devices', img: 'app-devices', title: 'An inventory that explains itself', body: 'Vendor, model, operating system and services, with the evidence behind every identification and launchers for SSH, RDP and web UIs.' },
  { id: 'wifi', label: 'Wi-Fi', img: 'app-wifi', title: 'Radio problem or backhaul problem?', body: 'RSSI, link rate, roams and disconnect reasons for this PC, nearby networks and channels, and per-AP health seen from the wired side.' },
  { id: 'health', label: 'Health', img: 'app-health', title: 'A health score with reasons', body: 'DNS, MTU black holes, bufferbloat, cleartext management, expired certificates, SMBv1 and rogue DHCP or router advertisements.' },
  { id: 'segments', label: 'Segments', img: 'app-segments', title: 'Subnets and VLANs, discovered', body: 'Other networks found through the route table, DHCP option 121, traceroute, SNMP and tagged DHCP probes.' },
];

const gallery = [
  { img: 'app-web', caption: 'Spider web with device inspector' },
  { img: 'tree', caption: 'Hierarchy tree' },
  { img: 'port-matrix', caption: 'Switch port matrix' },
  { img: 'welcome-step1', caption: 'First-run welcome' },
  { img: 'settings-updates', caption: 'Release and pre-release channels' },
  { img: 'update-available', caption: 'Built-in updater' },
  { img: 'about', caption: 'About NetSpider' },
];
---

<Base
  title="NetSpider — network diagnostics for Windows · FreeSense"
  description="NetSpider is a free, open-source Layer 2 / Layer 3 network diagnostic tool for Windows from the FreeSense project: device discovery, MAC-level latency, Path Doctor and Storm Center."
>
  <section class="ns-hero">
    <div class="ns-glow"></div>
    <div class="wrap">
      <div class="ns-hero-copy">
        <a href="/apps" class="ns-family"><img src={app.logo} alt="" width="28" height="28" /> A FreeSense app</a>
        <h1>Net<span>Spider</span></h1>
        <p class="ns-tagline">{app.tagline}</p>
        <p class="lede">{app.summary}</p>
        <div class="ns-cta">
          <a href="#download" class="btn ns-btn" id="hero-download">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"/></svg>
            Download for Windows
          </a>
          <a href={app.repo} class="btn btn-ghost" rel="noopener">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="ns-meta">
          <span class="ns-live"><i></i><span id="latest-version">v{app.version}</span></span>
          <span id="latest-date"></span>
          <span>Apache-2.0</span>
          <span>{app.platform}</span>
        </p>
      </div>
      <figure class="ns-hero-shot">
        <img src={`${IMG}/spider-web.webp`} alt="NetSpider spider-web view mapping a 43-device network with per-device latency" width="1600" height="900" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="ns-features">
    <div class="wrap">
      <div class="ns-heading"><span class="eyebrow">What it does</span><h2>From “the internet is slow” to the exact cable.</h2></div>
      <div class="ns-feature-grid">
        {features.map((f) => (
          <article class="ns-feature">
            <span class="ns-icon">
              {f.icon === 'web' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="2.5"/><path d="M12 2v7.5M12 14.5V22M2 12h7.5M14.5 12H22M4.9 4.9l5.3 5.3M13.8 13.8l5.3 5.3M19.1 4.9l-5.3 5.3M10.2 13.8l-5.3 5.3"/></svg>}
              {f.icon === 'pulse' && <svg viewBox="0 0 24 24"><path d="M2 12h4l3-8 6 16 3-8h4"/></svg>}
              {f.icon === 'path' && <svg viewBox="0 0 24 24"><circle cx="4" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="20" cy="12" r="2"/><path d="M6 12h4M14 12h4"/><path d="m17 6 3 3m0-3-3 3"/></svg>}
              {f.icon === 'storm' && <svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>}
              {f.icon === 'wifi' && <svg viewBox="0 0 24 24"><path d="M2 8.5a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M8.5 15.5a5 5 0 0 1 7 0"/><circle cx="12" cy="19" r="1"/></svg>}
              {f.icon === 'export' && <svg viewBox="0 0 24 24"><path d="M14 3h7v7M21 3l-9 9M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/></svg>}
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ns-tour" id="tour">
    <div class="wrap">
      <div class="ns-heading centered"><span class="eyebrow">Take the tour</span><h2>See what NetSpider sees.</h2></div>
      <div class="tour-tabs" role="tablist" aria-label="NetSpider views">
        {tour.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
        ))}
      </div>
      {tour.map((t, i) => (
        <div class="tour-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
          <div class="tour-copy"><h3>{t.title}</h3><p>{t.body}</p></div>
          <button type="button" class="tour-shot zoomable" data-full={`${IMG}/${t.img}.webp`} data-caption={t.title} aria-label={`Enlarge: ${t.title}`}>
            <img src={`${IMG}/${t.img}.webp`} alt={`NetSpider ${t.label} view`} loading={i === 0 ? 'eager' : 'lazy'} />
          </button>
        </div>
      ))}
    </div>
  </section>

  <section class="ns-gallery">
    <div class="wrap">
      <div class="ns-heading"><span class="eyebrow">More screens</span><h2>Built to be lived in.</h2></div>
      <div class="gallery-grid">
        {gallery.map((g) => (
          <figure>
            <button type="button" class="zoomable" data-full={`${IMG}/${g.img}.webp`} data-caption={g.caption} aria-label={`Enlarge: ${g.caption}`}>
              <img src={`${IMG}/${g.img}-thumb.webp`} alt={g.caption} loading="lazy" />
            </button>
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="ns-download" id="download">
    <div class="wrap">
      <div class="ns-heading centered">
        <span class="eyebrow">Download</span>
        <h2>Get NetSpider <span id="dl-version">{app.version}</span></h2>
        <p>Free and open source. Pick your architecture, then the package that fits.</p>
      </div>
      <div class="dl-box">
        <div class="arch-switch" role="radiogroup" aria-label="Architecture">
          <button type="button" role="radio" data-arch="win-x64" aria-checked="true">x64<small>Most PCs</small></button>
          <button type="button" role="radio" data-arch="win-arm64" aria-checked="false">ARM64<small>Snapdragon / ARM</small></button>
          <button type="button" role="radio" data-arch="win-x86" aria-checked="false">x86<small>32-bit Windows 10</small></button>
        </div>
        <div class="dl-grid" id="dl-grid">
          <a class="dl-card primary" href={app.releases} rel="noopener">
            <strong>Download from GitHub Releases</strong>
            <small>Installers, standalone exe, MSI and portable zip for x64, ARM64 and x86.</small>
          </a>
        </div>
        <p class="dl-foot" id="dl-foot"><a href={app.releases} rel="noopener">All files and checksums on GitHub →</a></p>
      </div>
      <div class="req-grid">
        <div><strong>Npcap required</strong><span>NetSpider needs <a href="https://npcap.com" rel="noopener">Npcap</a> for packet capture. Its license doesn't allow bundling, so NetSpider guides you through installing it on first start.</span></div>
        <div><strong>Administrator rights</strong><span>Raw packet capture needs elevation, so NetSpider asks for it at launch. The per-user installer itself needs no admin rights.</span></div>
        <div><strong>Not code-signed yet</strong><span>Windows SmartScreen may say “Windows protected your PC”. Choose <em>More info → Run anyway</em>, and verify files against <code>SHA256SUMS.txt</code>.</span></div>
      </div>
    </div>
  </section>

  <section class="ns-changelog" id="changelog">
    <div class="wrap">
      <div class="ns-heading split">
        <div><span class="eyebrow">Changelog</span><h2>What's new in NetSpider</h2></div>
        <p>Pulled live from <a href={`${app.repo}/releases`} rel="noopener">GitHub Releases</a>, so this page is always current.</p>
      </div>
      <div class="changelog" id="changelog-list" aria-live="polite">
        <article class="release static">
          <div class="release-head"><span class="release-tag">v{app.version}</span><span class="release-date">4 October 2026</span></div>
          <p>First public release. <a href={app.releases} rel="noopener">Read the release notes on GitHub →</a></p>
        </article>
      </div>
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Screenshot">
    <form method="dialog"><button class="lb-close" aria-label="Close">✕</button></form>
    <img id="lb-img" alt="" />
    <p id="lb-caption"></p>
  </dialog>
</Base>

<script>
  import { loadReleases, renderNotes, formatDate, formatSize, escapeHtml } from '../../scripts/app-releases';
  import type { AppRelease } from '../../scripts/app-releases';

  // --- Tabs -------------------------------------------------------------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tour-tabs [role="tab"]')];
  function selectTab(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      selectTab(next);
    });
  });

  // --- Lightbox ---------------------------------------------------------
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lb-caption')!;
  document.querySelectorAll<HTMLButtonElement>('.zoomable').forEach((button) => {
    button.addEventListener('click', () => {
      lbImg.src = button.dataset.full!;
      lbImg.alt = button.dataset.caption!;
      lbCaption.textContent = button.dataset.caption!;
      lightbox.showModal();
    });
  });
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close(); });

  // --- Live downloads + changelog --------------------------------------
  const PACKAGES = [
    { suffix: '-Setup.exe', exclude: 'PreRelease', title: 'Installer', badge: 'Recommended', body: 'Per-user install with shortcuts. Updates itself automatically. No admin rights needed to install.' },
    { suffix: '-Standalone.exe', title: 'Standalone', body: 'A single exe with nothing to install. Run it from anywhere, even a USB stick.' },
    { suffix: '-Portable.zip', title: 'Portable zip', body: 'Unzip and run. Updates are manual.' },
    { suffix: '.msi', title: 'MSI for IT', body: 'Machine-wide install for Intune, GPO or SCCM. Silent: msiexec /i <file> /qn.' },
    { suffix: '-PreRelease-Setup.exe', title: 'Pre-release installer', body: 'Same installer, but follows the Pre-release channel: early builds plus every release.' },
  ];
  let arch = 'win-x64';
  let current: AppRelease | null = null;

  function renderDownloads() {
    if (!current) return;
    const grid = document.getElementById('dl-grid')!;
    const cards = PACKAGES.map((pkg) => {
      const asset = current!.assets.find((a) => a.name.endsWith(`-${current!.version}-${arch}${pkg.suffix}`)
        && (!pkg.exclude || !a.name.includes(pkg.exclude)));
      if (!asset) return '';
      return `<a class="dl-card${pkg.badge ? ' primary' : ''}" href="${escapeHtml(asset.url)}">
        <strong>${escapeHtml(pkg.title)}${pkg.badge ? `<em>${pkg.badge}</em>` : ''}</strong>
        <small>${escapeHtml(pkg.body)}</small>
        <span class="dl-file">${escapeHtml(asset.name)} · ${formatSize(asset.size)}</span></a>`;
    }).join('');
    if (cards) grid.innerHTML = cards;
    const setup = current.assets.find((a) => a.name.endsWith(`-${current!.version}-${arch}-Setup.exe`) && !a.name.includes('PreRelease'));
    if (setup) (document.getElementById('hero-download') as HTMLAnchorElement).href = setup.url;
    const probes = current.assets.filter((a) => a.name.includes('-Probe-'));
    const sums = current.assets.find((a) => a.name === 'SHA256SUMS.txt');
    document.getElementById('dl-foot')!.innerHTML = [
      sums && `<a href="${escapeHtml(sums.url)}">SHA256SUMS.txt</a>`,
      probes.length && `<a href="${escapeHtml(current.url)}" rel="noopener">Probe agent (${probes.length} platforms)</a>`,
      `<a href="${escapeHtml(current.url)}" rel="noopener">Release ${escapeHtml(current.tag)} on GitHub →</a>`,
    ].filter(Boolean).join('<span aria-hidden="true">·</span>');
  }

  document.querySelectorAll<HTMLButtonElement>('.arch-switch button').forEach((button) => {
    button.addEventListener('click', () => {
      arch = button.dataset.arch!;
      document.querySelectorAll('.arch-switch button').forEach((b) => b.setAttribute('aria-checked', String(b === button)));
      renderDownloads();
    });
  });

  // Windows on ARM reports itself through client hints where supported.
  (navigator as any).userAgentData?.getHighEntropyValues?.(['architecture', 'bitness']).then((ua: any) => {
    if (ua?.architecture === 'arm') document.querySelector<HTMLButtonElement>('[data-arch="win-arm64"]')?.click();
  }).catch(() => {});

  loadReleases('netspider').then((feed) => {
    if (!feed || !feed.releases.length) return;
    current = feed.releases.find((r) => r.tag === feed.latest) ?? feed.releases[0];
    document.getElementById('latest-version')!.textContent = `${current.tag} · latest`;
    document.getElementById('latest-date')!.textContent = formatDate(current.published_at);
    document.getElementById('dl-version')!.textContent = current.version;
    renderDownloads();

    document.getElementById('changelog-list')!.innerHTML = feed.releases.map((release, i) => `
      <article class="release${i === 0 ? ' newest' : ''}">
        <div class="release-head">
          <span class="release-tag">${escapeHtml(release.tag)}</span>
          ${release.tag === feed.latest ? '<span class="release-badge">Latest</span>' : ''}
          ${release.prerelease ? '<span class="release-badge pre">Pre-release</span>' : ''}
          <span class="release-date">${escapeHtml(formatDate(release.published_at))}</span>
          <a href="${escapeHtml(release.url)}" rel="noopener">GitHub ↗</a>
        </div>
        <h3>${escapeHtml(release.name)}</h3>
        <div class="release-notes">${renderNotes(release.notes, feed.repo, release.name) || '<p>No release notes.</p>'}</div>
      </article>`).join('');
  });
</script>

<style>
  .ns-hero { --ns-cyan: #22c7f0; --ns-magenta: #c23ad6; padding: 80px 0 40px; overflow: hidden; }
  .ns-glow { position: absolute; inset: -200px -10% auto; height: 900px; background: radial-gradient(40% 45% at 30% 30%, rgba(34,199,240,.16), transparent 70%), radial-gradient(35% 40% at 75% 25%, rgba(194,58,214,.16), transparent 70%); pointer-events: none; }
  .ns-hero-copy { text-align: center; max-width: 820px; margin: 0 auto; }
  .ns-family { display: inline-flex; align-items: center; gap: 9px; padding: 5px 14px 5px 6px; border: 1px solid rgba(34,199,240,.3); border-radius: 999px; background: rgba(34,199,240,.07); color: #cfe9f3; font-size: 13px; }
  .ns-family img { border-radius: 7px; }
  .ns-family:hover { color: #fff; border-color: var(--ns-cyan); }
  .ns-hero h1 { font-size: clamp(56px, 9vw, 112px); line-height: .95; letter-spacing: -.06em; margin: 26px 0 8px; }
  .ns-hero h1 span { background: linear-gradient(100deg, var(--ns-cyan), var(--ns-magenta)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ns-tagline { font-size: clamp(20px, 2.4vw, 28px); font-weight: 600; margin: 0 0 18px; color: #e5ebf2; }
  .lede { color: var(--muted); font-size: 18px; line-height: 1.65; margin: 0 auto; max-width: 700px; }
  .ns-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .ns-btn { background: linear-gradient(120deg, #1ab6e0, #a92fc4); color: #fff; box-shadow: 0 14px 34px rgba(34,199,240,.22); }
  .ns-btn:hover { color: #fff; transform: translateY(-2px); background: linear-gradient(120deg, #2ccaf2, #c23ad6); }
  .ns-btn svg { width: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ns-meta { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; color: var(--muted-2); font-size: 13px; margin: 22px 0 0; }
  .ns-meta:empty, .ns-meta span:empty { display: none; }
  .ns-live { display: inline-flex; align-items: center; gap: 7px; color: #cfe9f3; font-family: var(--mono); font-size: 12.5px; }
  .ns-live i { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 4px rgba(62,207,142,.12); }
  .ns-hero-shot { margin: 56px auto 0; max-width: 1100px; border-radius: 16px; overflow: hidden; border: 1px solid rgba(120,140,170,.25); box-shadow: 0 40px 120px rgba(0,0,0,.55), 0 0 0 1px rgba(34,199,240,.08), 0 0 90px rgba(34,199,240,.12); }
  .ns-hero-shot img { display: block; width: 100%; height: auto; }

  .ns-heading h2 { font-size: clamp(32px, 4vw, 48px); letter-spacing: -.04em; margin: 10px 0 0; }
  .ns-heading.centered { text-align: center; max-width: 760px; margin: 0 auto 40px; }
  .ns-heading.centered p { color: var(--muted); margin: 14px 0 0; }
  .ns-heading.split { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 34px; }
  .ns-heading.split p { color: var(--muted); max-width: 420px; margin: 0; font-size: 15px; }
  .ns-features .ns-heading, .ns-gallery .ns-heading { margin-bottom: 38px; max-width: 720px; }
  .ns-features .eyebrow, .ns-tour .eyebrow, .ns-gallery .eyebrow, .ns-download .eyebrow, .ns-changelog .eyebrow { color: #4fd3f5; }

  .ns-features { padding: 90px 0; }
  .ns-feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ns-feature { background: linear-gradient(145deg, #182131, #141b26); border: 1px solid var(--border); border-radius: 16px; padding: 26px; transition: transform .2s, border-color .2s; }
  .ns-feature:hover { transform: translateY(-4px); border-color: rgba(34,199,240,.45); }
  .ns-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 11px; background: linear-gradient(135deg, rgba(34,199,240,.16), rgba(194,58,214,.16)); color: #6fdcf7; }
  .ns-icon svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .ns-feature h3 { font-size: 19px; margin: 22px 0 8px; }
  .ns-feature p { color: var(--muted); font-size: 14.5px; margin: 0; }

  .ns-tour { padding: 100px 0; background: #111720; border-block: 1px solid var(--border); }
  .tour-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 30px; }
  .tour-tabs button { font: inherit; font-size: 14px; font-weight: 500; color: var(--muted); background: #171f2b; border: 1px solid var(--border); border-radius: 999px; padding: 8px 16px; cursor: pointer; transition: color .15s, border-color .15s, background .15s; }
  .tour-tabs button:hover { color: var(--text); border-color: var(--border-2); }
  .tour-tabs button[aria-selected="true"] { color: #fff; border-color: transparent; background: linear-gradient(120deg, #1597bd, #8e2aa6); }
  .tour-panel { display: grid; grid-template-columns: .55fr 1.45fr; gap: 40px; align-items: center; animation: fade .3s ease; }
  .tour-panel[hidden] { display: none; }
  .tour-copy h3 { font-size: 26px; margin: 0 0 12px; letter-spacing: -.02em; }
  .tour-copy p { color: var(--muted); margin: 0; }
  .zoomable { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .tour-shot { border-radius: 14px; overflow: hidden; border: 1px solid #344257; box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .tour-shot img { display: block; width: 100%; height: auto; transition: transform .4s; }
  .tour-shot:hover img { transform: scale(1.015); }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } }

  .ns-gallery { padding: 100px 0; }
  .gallery-grid { columns: 3 300px; column-gap: 16px; }
  .gallery-grid figure { break-inside: avoid; margin: 0 0 16px; }
  .gallery-grid .zoomable { border-radius: 12px; overflow: hidden; border: 1px solid var(--border); transition: border-color .2s, transform .2s; }
  .gallery-grid .zoomable:hover { border-color: rgba(34,199,240,.5); transform: translateY(-3px); }
  .gallery-grid img { display: block; width: 100%; height: auto; }
