---
import ThemeSwitch from './ThemeSwitch.astro';
import ProductItems from './ProductItems.astro';
import { DOCS, GITHUB } from '../data/site';

interface Props { current?: string }
const { current = '' } = Astro.props;
const productPage = ['freesense', 'netspider', 'download'].includes(current);
const here = (key: string) => (current === key ? 'page' : undefined);
---
<a class="skip" href="#main">Skip to content</a>
<header class="fs-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="FreeSense home">
      <img class="logo-dark" src="/brand/lockup-white.svg" alt="FreeSense" width="170" height="40" />
      <img class="logo-light" src="/brand/lockup-light.svg" alt="FreeSense" width="170" height="40" />
    </a>
    <nav class="fs-nav" aria-label="Main">
      <div class="dropdown">
        <button type="button" class:list={[{ active: productPage }]} data-bs-toggle="dropdown" data-bs-offset="0,8" aria-expanded="false">
          Products <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <div class="dropdown-menu products-menu">
          <ProductItems />
        </div>
      </div>
      <a href="/news/" aria-current={here('news')}>News</a>
      <a href={DOCS}>Docs</a>
      <a href="/about/" aria-current={here('about')}>About</a>
      <a href={GITHUB} rel="noopener">GitHub</a>
    </nav>
    <div class="fs-actions">
      <ThemeSwitch />
      <a class="btn-pill btn-grad btn-sm-pill" href="/download/">Download</a>
      <button class="icon-btn menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#mnav" aria-controls="mnav" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="offcanvas offcanvas-end" tabindex="-1" id="mnav" aria-labelledby="mnav-title">
  <div class="offcanvas-header">
    <img class="logo-dark" src="/brand/lockup-white.svg" alt="" width="128" height="30" />
    <img class="logo-light" src="/brand/lockup-light.svg" alt="" width="128" height="30" />
    <h2 class="visually-hidden" id="mnav-title">Menu</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
  </div>
  <div class="offcanvas-body">
    <div class="m-label">Products</div>
    <ProductItems />
    <div class="m-label">Explore</div>
    <a class="m-link" href="/news/">News</a>
    <a class="m-link" href={DOCS}>Documentation</a>
    <a class="m-link" href="/about/">About</a>
    <a class="m-link" href={GITHUB} rel="noopener">GitHub</a>
    <div class="m-label">Theme</div>
    <ThemeSwitch />
    <a class="btn-pill btn-grad w-100 mt-4" href="/download/">Download FreeSense</a>
  </div>
</div>
