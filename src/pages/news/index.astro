---
import Base from '../../layouts/Base.astro';
import { news, formatDate } from '../../data/news';
const [featured, ...rest] = news;
---

<Base title="News — FreeSense" description="Releases, new apps and project news from FreeSense.">
  <section class="news-hero">
    <div class="wrap">
      <span class="eyebrow">News</span>
      <h1>What's happening at FreeSense</h1>
      <p class="lede">Releases, new apps and updates from the project.</p>
    </div>
  </section>

  <section class="news-list">
    <div class="wrap">
      <a href={`/news/${featured.slug}`} class="featured">
        {featured.image && <div class="featured-img"><img src={featured.image} alt={featured.imageAlt ?? ''} /></div>}
        <div class="featured-copy">
          <div class="meta"><span class="tag">{featured.tag}</span><time datetime={featured.date}>{formatDate(featured.date)}</time></div>
          <h2>{featured.title}</h2>
          <p>{featured.summary}</p>
          <span class="more">Read more →</span>
        </div>
      </a>

      <div class="post-grid">
        {rest.map((post) => (
          <a href={`/news/${post.slug}`} class="post">
            <div class="meta"><span class="tag">{post.tag}</span><time datetime={post.date}>{formatDate(post.date)}</time></div>
            <h3>{post.title}</h3>
            <p>{post.summary}</p>
            <span class="more">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .news-hero { padding: 80px 0 10px; }
  .news-hero h1 { font-size: clamp(36px, 5vw, 58px); letter-spacing: -.045em; margin: 12px 0 0; }
  .lede { color: var(--muted); font-size: 19px; margin: 14px 0 0; }
  .news-list { padding: 40px 0 70px; }
  .featured { display: grid; grid-template-columns: 1.2fr 1fr; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; background: #171f2b; color: var(--text); transition: border-color .2s; }
  .featured:hover { color: var(--text); border-color: var(--border-2); }
  .featured-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .featured-copy { padding: 34px; align-self: center; }
  .featured h2 { font-size: clamp(24px, 2.6vw, 32px); margin: 14px 0 12px; letter-spacing: -.03em; }
  .featured p, .post p { color: var(--muted); margin: 0; }
  .meta { display: flex; gap: 12px; align-items: center; font-size: 13px; color: var(--muted-2); }
  .tag { color: var(--coral-hi); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; font-size: 11.5px; border: 1px solid rgba(255,107,74,.3); background: var(--coral-soft); border-radius: 999px; padding: 2px 9px; }
  .more { display: inline-block; margin-top: 18px; color: var(--coral-hi); font-weight: 600; font-size: 15px; }
  .post-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .post { padding: 26px; border: 1px solid var(--border); border-radius: 16px; background: #171f2b; color: var(--text); transition: border-color .2s, transform .2s; }
  .post:hover { color: var(--text); border-color: var(--border-2); transform: translateY(-3px); }
  .post h3 { font-size: 21px; margin: 14px 0 10px; }
  .post p { font-size: 15px; }
  @media (max-width: 820px) {
    .featured, .post-grid { grid-template-columns: 1fr; }
    .featured-copy { padding: 24px; }
  }
</style>
